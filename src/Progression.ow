import "mathlib.ow"

# Pure RPG progression maths, ported from src/utils/gameUtils.js.
# Design invariant from the original: at the player's expected
# difficulty, one mob kill equals one level (BASE values give 5 hits
# to kill and 1 kill = 1 level).
class Progression:
  field ready

  fn new():
    set this.ready: 1

  # 3 ^ (difficulty - 1):  d1=1, d2=3, d3=9, d4=27, ...
  fn diff_mult(d):
    return: ipow(3, d - 1)

  # Damage per correct answer (BASE_DAMAGE = 12).
  fn damage(d):
    return: 12 * this.diff_mult(d)

  # Mob max HP (BASE_MOB_HEALTH = 60 = 5 * 12 -> five hits to kill).
  fn mob_health(d):
    return: 60 * this.diff_mult(d)

  # Expected difficulty for a level: unlocks every 20 levels, capped at 7.
  fn expected_diff(level):
    return: imin(7, idiv(level - 1, 20) + 1)

  # Encounter code: 2 = boss, 1 = miniboss, 0 = hostile.
  # Cycle of 20: position 20 -> boss, position 10 -> miniboss.
  fn encounter(level):
    set c int: imod(level - 1, 20) + 1
    if: c == 20
      return: 2
    if: c == 10
      return: 1
    return: 0

  # XP needed to clear one level (BASE_XP_TO_LEVEL = 100).
  fn xp_to_level(d):
    return: 100 * this.diff_mult(d)

  # XP granted for a kill. Full reward at or above the expected
  # difficulty; an integer penalty of /3 per difficulty below it.
  # (The JS uses a 0.3^gap float penalty; see docs/PORTING.md.)
  fn xp_reward(d, level):
    set full int: 100 * this.diff_mult(d)
    set exp int: this.expected_diff(level)
    if: d > (exp - 1)
      return: full
    set gap int: exp - d
    return: idiv(full, ipow(3, gap))
