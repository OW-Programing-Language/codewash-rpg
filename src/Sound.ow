# Original Code Wash sounds. Audio device failures leave the game playable.
class Sound:
  field enabled

  fn new():
    set this.enabled: 1

  fn mute():
    call: audio_stop()
    set this.enabled: 0

  fn toggle():
    if: this.enabled == 1
      call: this.mute()
    else:
      set this.enabled: 1
      call: this.start_music()

  fn play(path):
    if: this.enabled == 1
      try:
        call: audio_play(path)
      catch err:
        print: "Sound unavailable: " + err
        call: this.mute()

  fn hit():
    call: this.play("assets/sounds/ui/ui/successful_hit.wav")

  fn kill():
    call: this.play("assets/sounds/ui/ui/notification.wav")

  fn wrong():
    call: this.play("assets/sounds/ui/ui/fail.wav")

  fn levelup():
    call: this.play("assets/sounds/ui/ui/levelup.wav")

  fn mob(name, event):
    set folder: replace(lower(name), " ", "")
    if: name == "Enderman"
      set folder: "endermen"
    if: name == "Wither Skeleton"
      set folder: "wither_skeleton"
    set path: "assets/sounds/mob/mob/" + folder + "/" + event + ".wav"
    if: exists(path) == 1
      call: this.play(path)
    else:
      call: this.hit()

  fn start_music():
    if: this.enabled == 1
      set tracks: ["calm1", "calm2", "calm3", "piano1", "piano2", "piano3"]
      try:
        call: audio_music("assets/sounds/bgm/" + tracks[rand(6)] + ".wav")
      catch err:
        print: "Music unavailable: " + err
        call: this.mute()

  fn stop_music():
    call: audio_stop()
