import "mathlib.ow"
import "Progression.ow"
import "MobPool.ow"
import "Mob.ow"
import "Hero.ow"
import "Sound.ow"
import "ReadingWords.ow"
import "store.ow"
import "Achievements.ow"
import "Cosmetics.ow"

# Voice + audio variant of the combat loop: the player reads a word ALOUD
# to attack (resolved by the host via mic_transcribe), and the Ow audio
# builtins play sound effects and looping music. Reuses the same engine
# (Progression / MobPool / Mob / Hero) as the math game.
class GameAV:
  field prog
  field pool
  field hero
  field mob
  field sound
  field words
  field word
  field message
  field ach
  field kills
  field cos

  fn new():
    set this.prog: new Progression()
    set this.pool: new MobPool()
    set this.hero: new Hero()
    set this.mob: new Mob()
    set this.sound: new Sound()
    set this.words: new ReadingWords()
    set this.ach: new Achievements()
    set this.cos: new Cosmetics()
    set this.kills: 0
    set this.word: "cat"
    set this.message: "Welcome to Code Wash RPG (voice)."

  # Resumes saved progress + achievements (shared with the math game), or
  # starts fresh.
  fn start(d):
    set saved: load_progress()
    if: saved == 0
      call: this.hero.init(d)
      set this.message: "A new washer clocks in. Read the word aloud!"
    else:
      call: this.hero.restore(saved[0], saved[1], saved[2])
      set this.message: "Welcome back at level " + this.hero.lvl() + "! Read the word aloud!"
    call: this.ach.load()
    call: this.spawn()
    call: this.next_word()
    call: this.sound.start_music()

  fn spawn():
    set code int: this.prog.encounter(this.hero.lvl())
    set name: this.pool.pick(code)
    set hp int: this.prog.mob_health(this.hero.diff())
    set m: new Mob()
    call: m.init(name, hp)
    set this.mob: m

  fn next_word():
    set this.word: this.words.pick()

  # Resolve one spoken attempt (`heard` is the transcribed, lowercased word).
  fn say(heard):
    if: heard == this.word
      call: this.hit()
    else:
      call: this.sound.wrong()
      set this.message: "Not quite -- I heard '" + heard + "', wanted '" + this.word + "'"
    call: this.next_word()

  fn hit():
    set dmg int: this.prog.damage(this.hero.diff())
    call: this.mob.hurt(dmg)
    if: this.mob.dead() == 1
      call: this.reward()
    else:
      call: this.sound.hit()
      set this.message: "Hit! " + this.mob.label() + " has " + this.mob.cur_hp() + " HP left"

  fn reward():
    set xp int: this.prog.xp_reward(this.hero.diff(), this.hero.lvl())
    call: this.hero.gain(xp)
    set need int: this.prog.xp_to_level(this.hero.diff())
    set ups int: 0
    while: this.hero.xp_v() > (need - 1)
      call: this.hero.level_up(need)
      set ups: ups + 1
      set need: this.prog.xp_to_level(this.hero.diff())
    set this.kills: this.kills + 1
    call: this.sound.kill()
    set this.message: this.mob.label() + " defeated! +" + xp + " XP"
    if: ups > 0
      call: this.sound.levelup()
      set this.message: this.message + " -- Level up! Now level " + this.hero.lvl()
    # Persist progress + unlock achievements (shared with the math game).
    call: save_progress(this.hero.lvl(), this.hero.xp_v(), this.hero.diff())
    set earned: this.ach.check(this.hero.lvl(), this.kills)
    call: this.ach.persist()
    if: len(earned) > 0
      set this.message: this.message + " -- Achievement unlocked: " + earned
    call: this.spawn()

  fn prompt_line():
    return: this.cos.tag() + "[Lvl " + this.hero.lvl() + "  Foe: " + this.mob.label() + " " + this.mob.cur_hp() + "/" + this.mob.max_hp() + "]  SAY: " + this.word
