import "Theme.ow"

# The bestiary, now sourced from the active Theme (see Theme.ow) rather than
# hardcoded names. pick(code) returns a mob name by encounter code:
#   2 = boss, 1 = miniboss, 0 = hostile.
class MobPool:
  field theme

  fn new():
    set this.theme: new Theme()

  fn pick(code):
    switch: code
      case 2:
        return: this.theme.pick_boss()
      case 1:
        return: this.theme.pick_mini()
      default:
        return: this.theme.pick_hostile()

  # The themed foe image and title, used by the graphical mode.
  fn theme_image():
    return: this.theme.image()

  fn mob_image(name):
    return: this.theme.image_for(name)

  fn theme_title():
    return: this.theme.title()
