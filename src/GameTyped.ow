import "mathlib.ow"
import "Progression.ow"
import "MobPool.ow"
import "Mob.ow"
import "Hero.ow"
import "store.ow"
import "Achievements.ow"
import "Cosmetics.ow"

# A generic typed-combat loop, driven by any "skill" object that implements:
#   next(difficulty)  -- advance to a new challenge
#   prompt()          -- the string to show the player
#   check(typed)      -- 1 if the typed answer is correct, else 0
#   target()          -- a short "the answer was ..." feedback string
#
# This is the reusable core behind the Patterns and Cleaning modes (and a
# template for future skills). Attach the skill with use(...) before start().
# Shares the engine + save/achievement system with every other mode.
class GameTyped:
  field prog
  field pool
  field hero
  field mob
  field skill
  field message
  field ach
  field kills
  field cos

  fn new():
    set this.prog: new Progression()
    set this.pool: new MobPool()
    set this.hero: new Hero()
    set this.mob: new Mob()
    set this.ach: new Achievements()
    set this.kills: 0
    set this.skill: 0
    set this.cos: new Cosmetics()
    set this.message: "Welcome to Code Wash RPG."

  fn use(s):
    set this.skill: s

  fn start(d):
    set saved: load_progress()
    if: saved == 0
      call: this.hero.init(d)
      set this.message: "A new washer clocks in. A challenge appears!"
    else:
      call: this.hero.restore(saved[0], saved[1], saved[2])
      set this.message: "Welcome back at level " + this.hero.lvl() + "! A challenge appears!"
    call: this.ach.load()
    call: this.spawn()
    call: this.skill.next(this.hero.diff())

  fn spawn():
    set code int: this.prog.encounter(this.hero.lvl())
    set name: this.pool.pick(code)
    set hp int: this.prog.mob_health(this.hero.diff())
    set m: new Mob()
    call: m.init(name, hp)
    set this.mob: m

  fn answer(typed):
    if: this.skill.check(typed) == 1
      call: this.hit()
    else:
      set this.message: "Not quite -- " + this.skill.target()
    call: this.skill.next(this.hero.diff())

  fn hit():
    set dmg int: this.prog.damage(this.hero.diff())
    call: this.mob.hurt(dmg)
    if: this.mob.dead() == 1
      call: this.reward()
    else:
      set this.message: "Hit! " + this.mob.label() + " has " + this.mob.cur_hp() + " HP left"

  fn reward():
    set xp int: this.prog.xp_reward(this.hero.diff(), this.hero.lvl())
    call: this.hero.gain(xp)
    set need int: this.prog.xp_to_level(this.hero.diff())
    set ups int: 0
    while: this.hero.xp_v() > (need - 1)
      call: this.hero.level_up(need)
      set ups: ups + 1
      set need: this.prog.xp_to_level(this.hero.diff())
    set this.kills: this.kills + 1
    set this.message: this.mob.label() + " defeated! +" + xp + " XP"
    if: ups > 0
      set this.message: this.message + " -- Level up! Now level " + this.hero.lvl()
    call: save_progress(this.hero.lvl(), this.hero.xp_v(), this.hero.diff())
    set earned: this.ach.check(this.hero.lvl(), this.kills)
    call: this.ach.persist()
    if: len(earned) > 0
      set this.message: this.message + " -- Achievement unlocked: " + earned
    call: this.spawn()

  fn prompt_line():
    return: this.cos.tag() + "[Lvl " + this.hero.lvl() + "  Diff " + this.hero.diff() + "  Foe: " + this.mob.label() + " " + this.mob.cur_hp() + "/" + this.mob.max_hp() + "]  " + this.skill.prompt()
