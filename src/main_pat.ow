import "GameTyped.ow"
import "PatternSkill.ow"

# Pattern-recognition mode: read the arithmetic sequence and type the next
# number to attack. Shares engine + saved progress with the other modes.
#
#   ow run src/main_pat.ow
main:
  set game: new GameTyped()
  call: game.use(new PatternSkill())
  call: game.start(1)
  print: "=== Code Wash RPG -- Patterns skill ==="
  print: "Type the next number in each sequence. Reach level 6 to win."
  print: "(Progress is saved -- you resume where you left off.)"
  set playing int: 1
  while: playing == 1
    print: game.prompt_line()
    set n: input("Next > ")
    call: game.answer(n)
    print: game.message
    if: game.hero.lvl() > 5
      set playing: 0
  print: "You reached level " + game.hero.lvl() + " with " + game.ach.count_unlocked() + "/5 achievements. Shift finished, washer!"
