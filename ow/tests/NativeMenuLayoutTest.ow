# Pure OW 16:9 UI layout tests — no OpenGL context required.
import "@owunit/src/OWAssert.ow"
import "../src/engine/NativeMenuLayout.ow"

class NativeMenuLayoutTest:
  field check
  field layout

  @BeforeEach
  fn setup():
    set this.check: new OWAssert()
    set this.layout: new NativeMenuLayout()

  @Test
  fn nativeMenuStartsInWideScreen():
    call: this.check.assertEquals(1280, this.layout.width())
    call: this.check.assertEquals(720, this.layout.height())
    call: this.check.assertEquals(16.0, this.layout.aspect() * 9.0)

  @Test
  fn featuresAreCenteredAndWithinClipSpace():
    call: this.check.assertEquals(0.0, this.layout.panel_x(1) + this.layout.panel_width(1) / 2.0)
    call: this.check.assertEquals(1, this.layout.panel_width(1) > this.layout.panel_width(0))
    call: this.check.assertEquals(1, this.layout.panel_x(0) + this.layout.panel_width(0) < this.layout.panel_x(1))
    call: this.check.assertEquals(1, this.layout.panel_x(1) + this.layout.panel_width(1) < this.layout.panel_x(2))
    call: this.check.assertEquals(1, this.layout.logo_y() > 0.6)
    call: this.check.assertEquals(1, this.layout.button_y() > 0.7)

  @Test
  fn theMenuBuildsFiveRealIconControlsAndDecorativeCards():
    set buttons: this.layout.button_vertices()
    set frame: this.layout.chrome_vertices()
    call: this.check.assertEquals(90, len(buttons))
    call: this.check.assertEquals(1728, len(frame))
    call: this.check.assertEquals(0.0 - 0.963, buttons[0])
    call: this.check.assertEquals(0 - 5, buttons[2])
    call: this.check.assertEquals(0 - 5, buttons[20])
    call: this.check.assertEquals(0 - 5, buttons[38])
    call: this.check.assertEquals(0 - 5, buttons[56])
    call: this.check.assertEquals(1, frame[0] < 0.0)
    call: this.check.assertEquals(1, len(this.layout.toolbar_icon_vertices()) >= 500)
    call: this.check.assertEquals(0.866, this.layout.toolbar_x(4))
    call: this.check.assertEquals(1, this.layout.toolbar_y(4) < 0.0 - 0.8)
    call: this.check.assertEquals(180, len(this.layout.panel_vertices()))
    call: this.check.assertEquals(0.089, this.layout.button_width())
    call: this.check.assertEquals(1, this.layout.toolbar_y(4) > 0.0 - 0.93)
    call: this.check.assertEquals(1, this.layout.toolbar_y(4) + this.layout.button_height() < 0.0 - 0.70)
