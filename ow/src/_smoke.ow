import "UiGame.ow"

main:
  set app: new UiGame()
  call: app.set_sound(0)
  print: "sound enabled after disable: " + app.app.is_enabled("sound")
  call: app.begin_math()
  set i int: 0
  while: i < 12
    call: app.pick(app.game.problem.solution())
    set i: i + 1
  print: "achievements unlocked: " + app.ach_count()
  print: "level: " + app.game.hero.lvl()
  print: "reload achievements ->"
  call: app.app.reload("achievements")
  print: "achievements after reload: " + app.ach_count()
