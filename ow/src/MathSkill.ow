import "Problem.ow"
import "@math/src/MathQuestions.ow"

# Generates math problems per difficulty tier (1-7), ported from
# generateMathProblem() in src/utils/gameUtils.js.
# Operators are written in ASCII (* and /) for the OW console; the
# original uses the unicode glyphs x and / (see docs/PORTING.md).
#
# The game keeps its own difficulty policy (operand ranges per tier), but the
# arithmetic and question text come from the reusable ow-math-questions library
# (dependency @math, declared in dependencies.yml). See docs/PORTING.md.
class MathSkill:
  field ready
  field math

  fn new():
    set this.ready: 1
    set this.math: new MathQuestions()

  fn mode():
    return: "choice"

  # Random int in [lo, hi].
  fn between(lo, hi):
    return: rand(hi - lo + 1) + lo

  fn generate(d):
    if: d == 6
      return: this.pemdas()
    if: d == 7
      return: this.nightmare()
    return: this.basic(d)

  # Four multiple-choice answers (ints) including the correct one, which is
  # placed off the first position. Used by the GUI's answer buttons.
  fn options(p):
    set s int: p.solution()
    set lo int: s - 1
    if: lo < 0
      set lo: s + 3
    return: [s + 1, lo, s, s + 2]

  # Difficulties 1-5: pick an operator allowed at this tier, then build a problem
  # whose answer is a non-negative integer. Operand ranges are the game's own
  # difficulty policy; the arithmetic and the prompt string come from the
  # @math library's from_operands(), so answers stay consistent with the lib.
  fn basic(d):
    set hi int: 20
    if: d == 1
      set hi: 9
    set op int: this.pick_op(d)
    set left int: 0
    set right int: 0
    set sym: "+"
    switch: op
      case 0:
        set left: this.between(0, hi)
        set right: this.between(0, hi)
        set sym: "+"
      case 1:
        set left: this.between(1, hi)
        set right: this.between(1, left)
        set sym: "-"
      case 2:
        set left: this.between(1, 10)
        set right: this.between(1, 10)
        set sym: "*"
      default:
        # Build a clean division: dividend / divisor with an integer quotient.
        set right: this.between(1, 10)
        set quotient int: this.between(1, 10)
        set left: right * quotient
        set sym: "/"
    set q: this.math.from_operands(sym, left, right)
    set p: new Problem()
    call: p.init(q.prompt, q.answer)
    return: p

  # Operator codes: 0=+, 1=-, 2=*, 3=/  constrained by difficulty.
  fn pick_op(d):
    if: d == 1
      return: 0
    if: d == 2
      return: 0
    if: d == 3
      return: rand(2)
    if: d == 4
      return: rand(3)
    return: rand(4)

  # Difficulty 6: order-of-operations table. A dictionary (new OW style) maps each
  # question to its answer, replacing the old parallel qs[]/ans[] arrays.
  fn pemdas():
    set table: {
      "3 + 4 * 2": 11,
      "(2 + 3) * 4": 20,
      "10 - 2 * 3": 4,
      "(5 + 5) / 2": 5,
      "8 / 2 + 3": 7,
      "2 * 3 + 4": 10,
      "15 - 3 * 3": 6,
      "(4 + 2) * 3": 18,
      "12 / 3 + 5": 9,
      "2 + 6 / 2": 5,
      "(8 - 3) * 2": 10,
      "4 * 2 - 1": 7
    }
    return: this.from_table(table)

  # Difficulty 7: nightmare multi-step table, same dictionary style.
  fn nightmare():
    set table: {
      "((25 - 10) * 4 + 18) / 2 - 7": 32,
      "(50 / 5 + 3) * 6 - 28": 50,
      "100 - (8 * 7 - 12) / 2": 78,
      "((15 + 9) * 3 - 20) / 4": 13,
      "(80 - 32) / 6 + 15 * 2": 38,
      "((40 / 8 + 7) * 6 - 18) / 3": 18,
      "120 / (12 - 2) + 8 * 5": 52,
      "(18 + 22) * 2 - 35 / 7": 75,
      "((64 - 16) / 4 + 9) * 3": 63,
      "(100 - 45) / 5 + 17 * 2": 45,
      "((36 / 6 + 8) * 4 - 20) / 2": 18,
      "(72 / 9 - 3) * 7 + 15": 50
    }
    return: this.from_table(table)

  # Pick a random question->answer pair from a dictionary table and build a Problem.
  fn from_table(table):
    set keys: map_keys(table)
    set q: keys[rand(len(keys))]
    set p: new Problem()
    call: p.init(q + " = ?", table[q])
    return: p
