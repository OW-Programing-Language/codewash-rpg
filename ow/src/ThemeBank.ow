# Themes, ported from THEME_CONFIG / THEMES_LIST in src/constants/gameData.jsx.
# Each theme swaps the background and logo (the mob/chest art is shared, as in the
# React app where most themes reuse the base art). Paths resolve from the ow/
# folder. A theme with no dedicated logo inherits the base (Minecraft) logo.
class ThemeBank:
  field ids

  fn new():
    set this.ids: ["minecraft", "kpop", "pokemon", "spy", "scifi", "fantasy"]

  fn all():
    return: this.ids

  fn name(id):
    switch: id
      case "minecraft":
        return: "Minecraft"
      case "kpop":
        return: "K-Pop"
      case "pokemon":
        return: "Pokemon"
      case "spy":
        return: "Spy"
      case "scifi":
        return: "Sci-Fi"
      case "fantasy":
        return: "Fantasy"
      default:
        return: "Minecraft"

  fn bg(id):
    switch: id
      case "minecraft":
        return: "../public/assets/themes/minecraft.png"
      case "kpop":
        return: "../public/assets/themes/kpop.jpg"
      case "pokemon":
        return: "../public/assets/themes/pokemon.jpg"
      case "spy":
        return: "../public/assets/themes/spy.png"
      case "scifi":
        return: "../public/assets/themes/Scifi.png"
      case "fantasy":
        return: "../public/assets/themes/fantasy.png"
      default:
        return: "../public/assets/themes/minecraft.png"

  fn logo(id):
    switch: id
      case "kpop":
        return: "../public/assets/themes/kpop_logo.png"
      case "pokemon":
        return: "../public/assets/themes/pokemon_logo.png"
      default:
        return: "../public/assets/themes/minecraft_logo.png"
