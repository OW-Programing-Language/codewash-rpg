# Themes, ported from THEME_CONFIG / THEMES_LIST in src/constants/gameData.jsx.
# Paths resolve from ow/. Unknown themes and missing logos use Minecraft.
class ThemeBank:
  field ids
  field themes

  fn new():
    set this.themes: {
      "minecraft": {name: "Minecraft", bg: "minecraft.png", logo: "minecraft_logo.png"},
      "kpop": {name: "K-Pop", bg: "kpop.jpg", logo: "kpop_logo.png"},
      "pokemon": {name: "Pokemon", bg: "pokemon.jpg", logo: "pokemon_logo.png"},
      "spy": {name: "Spy", bg: "spy.png"},
      "scifi": {name: "Sci-Fi", bg: "Scifi.png"},
      "fantasy": {name: "Fantasy", bg: "fantasy.png"}
    }
    # OW dictionaries preserve insertion order for the theme selector.
    set this.ids: map_keys(this.themes)

  fn all():
    return: this.ids

  fn name(id):
    set tb_theme: map_get(this.themes, id, this.themes.minecraft)
    return: tb_theme.name

  fn bg(id):
    set tb_theme: map_get(this.themes, id, this.themes.minecraft)
    return: "../public/assets/themes/" + tb_theme.bg

  fn logo(id):
    set tb_theme: map_get(this.themes, id, this.themes.minecraft)
    return: "../public/assets/themes/" + map_get(tb_theme, "logo", this.themes.minecraft.logo)
