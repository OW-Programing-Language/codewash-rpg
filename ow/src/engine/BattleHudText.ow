# Pure OW bitmap text geometry for the experimental OpenGL battle.
# ASCII indices match the glyph table compiled into BattleHud's shader.
import "NativeTypographyStyle.ow"
class BattleHudText:
  field alphabet
  field menu_alphabet
  field styles

  fn new():
    set this.alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-*/()=? :.!%"
    # Same casing as Electron's VT323 CSS text, instead of all-uppercase
    # 5x7 glyphs. The gameplay font remains unchanged.
    set this.menu_alphabet: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+-*/()=? :.!%'"
    set this.styles: new NativeTypographyStyle()

  fn menu_code_for(char):
    set code int: index_of(this.menu_alphabet, char)
    if: code < 0
      return: index_of(this.menu_alphabet, "?")
    return: code

  fn code_for(char):
    set code int: index_of(this.alphabet, upper(char))
    if: code < 0
      return: index_of(this.alphabet, "?")
    return: code

  # Encode each glyph as two triangles with character+corner in vertex Z.
  fn glyph(buffer, at, code, x, y):
    set width float: 0.034
    set height float: 0.069
    set encoded int: code * 8
    set buffer[at]: x
    set buffer[at + 1]: y
    set buffer[at + 2]: encoded
    set buffer[at + 3]: x + width
    set buffer[at + 4]: y
    set buffer[at + 5]: encoded + 1
    set buffer[at + 6]: x + width
    set buffer[at + 7]: y + height
    set buffer[at + 8]: encoded + 2
    set buffer[at + 9]: x
    set buffer[at + 10]: y
    set buffer[at + 11]: encoded
    set buffer[at + 12]: x + width
    set buffer[at + 13]: y + height
    set buffer[at + 14]: encoded + 2
    set buffer[at + 15]: x
    set buffer[at + 16]: y + height
    set buffer[at + 17]: encoded + 3
    return: at + 18

  fn line(buffer, at, text, x, y, limit):
    set count int: len(text)
    if: count > limit
      set count: limit
    set i int: 0
    while: i < count
      if: at + 18 > len(buffer)
        return: at
      set code int: this.code_for(char_at(text, i))
      set at: this.glyph(buffer, at, code, x + i * 0.038, y)
      set i: i + 1
    return: at

  fn vertices(battle):
    # 240 glyph slots, 4320 floats: comfortably below Graphics' 300000 cap.
    # Unused zero-coordinates are degenerate, zero-area triangles.
    set buffer: array(4320, 0.0)
    set at int: 0
    set status: "LVL " + str(battle.game.hero.lvl()) + "  MOB " + str(battle.game.mob.cur_hp()) + "/" + str(battle.game.mob.max_hp())
    set question: upper(battle.skill_name) + " " + upper(battle.game.problem.ask())
    set answers: battle.options()
    set at: this.line(buffer, at, status, 0.0 - 0.93, 0.86, 45)
    set at: this.line(buffer, at, question, 0.0 - 0.93, 0.69, 45)
    set at: this.line(buffer, at, "ARROWS MOVE  SPACE CONFIRM", 0.0 - 0.93, 0.43, 45)
    set at: this.line(buffer, at, "W  " + str(answers[0]), 0.0 - 0.88, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "A  " + str(answers[1]), 0.09, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "S  " + str(answers[2]), 0.0 - 0.88, 0.0 - 0.94, 20)
    set at: this.line(buffer, at, "D  " + str(answers[3]), 0.09, 0.0 - 0.94, 20)
    return: buffer

  # Menu text can be laid out independently from the battle bitmap font.
  # A larger title and tighter button labels share exactly the same 5x7 glyph
  # shader while retaining a bounded 240-glyph mesh.
  fn glyph_scaled(buffer, at, code, x, y, w, h):
    # 2048+code*8 marks the font atlas. Shade bits use 768 increments;
    # legacy 0..391 battle glyphs still use original 5x7 shader.
    set encoded int: 2048 + code * 8
    set buffer[at]: x
    set buffer[at + 1]: y
    set buffer[at + 2]: encoded
    set buffer[at + 3]: x + w
    set buffer[at + 4]: y
    set buffer[at + 5]: encoded + 1
    set buffer[at + 6]: x + w
    set buffer[at + 7]: y + h
    set buffer[at + 8]: encoded + 2
    set buffer[at + 9]: x
    set buffer[at + 10]: y
    set buffer[at + 11]: encoded
    set buffer[at + 12]: x + w
    set buffer[at + 13]: y + h
    set buffer[at + 14]: encoded + 2
    set buffer[at + 15]: x
    set buffer[at + 16]: y + h
    set buffer[at + 17]: encoded + 3
    return: at + 18

  fn menu_line(buffer, at, value, x, y, limit, width, height, step):
    set count int: len(value)
    if: count > limit
      set count: limit
    set i int: 0
    while: i < count
      if: at + 18 > len(buffer)
        return: at
      set char: char_at(value, i)
      set at: this.glyph_scaled(buffer, at, this.menu_code_for(char), x + step * i, y, width, height)
      set i: i + 1
    return: at

  # The last bit of each glyph's encoded corner carries an optional tint.
  # This enables a gold LEVEL UP banner while reusing the native bitmap shader.
  fn menu_line_gold(buffer, at, value, x, y, limit, width, height, step):
    set count int: len(value)
    if: count > limit
      set count: limit
    set i int: 0
    while: i < count
      if: at + 18 > len(buffer)
        return: at
      set at: this.glyph_scaled(buffer, at, this.menu_code_for(char_at(value, i)), x + step * i, y, width, height)
      set j int: at - 18
      while: j < at
        set buffer[j + 2]: buffer[j + 2] + 4
        set j: j + 3
      set i: i + 1
    return: at

  # Shared role-based geometry is defined in NativeTypographyStyle.ow.
  # Natural advances follow the original VT323 font cell proportions.
  # The text is fitted only when required, shrinking both width AND height.
  fn role_line(buffer, at, value, x, y, available, role, distance, cap, fade, centered):
    set height float: this.styles.height(role, distance)
    set metrics: this.styles.metrics(value, available, height, cap, role)
    if: metrics[4] < 1
      return: at
    set px float: x
    if: centered == 1
      set px: x + (available - metrics[3]) / 2.0
    set start int: at
    set at: this.menu_line(buffer, at, value, px, y, metrics[4], metrics[0], metrics[2], metrics[1])
    if: fade > 0
      set k int: start
      while: k < at
        set buffer[k + 2]: buffer[k + 2] + 768 * fade
        set k: k + 3
    return: at

  fn role_gold(buffer, at, value, x, y, available, role, cap):
    set height float: this.styles.height(role, 0.0)
    set metrics: this.styles.metrics(value, available, height, cap, role)
    if: metrics[4] < 1
      return: at
    set center_x float: x + (available - metrics[3]) / 2.0
    return: this.menu_line_gold(buffer, at, value, center_x, y, metrics[4], metrics[0], metrics[2], metrics[1])

  # Keep compatibility for existing OWUnit clients and battle diagnostics.
  # Unlike the old version, this helper never stretches short words to fill
  # the entire destination rectangle.
  fn fitted_line(buffer, at, value, x, y, available, height, cap):
    set metrics: this.styles.metrics(value, available, height, cap, "title")
    if: metrics[4] < 1
      return: at
    return: this.menu_line(buffer, at, value, x, y, metrics[4], metrics[0], metrics[2], metrics[1])

  fn centered_line(buffer, at, value, x, y, available, height, cap):
    set metrics: this.styles.metrics(value, available, height, cap, "title")
    if: metrics[4] < 1
      return: at
    set centered_x float: x + (available - metrics[3]) / 2.0
    return: this.menu_line(buffer, at, value, centered_x, y, metrics[4], metrics[0], metrics[2], metrics[1])

  fn centered_faded_line(buffer, at, value, x, y, available, height, cap, fade):
    set metrics: this.styles.metrics(value, available, height, cap, "mob")
    if: metrics[4] < 1
      return: at
    set centered_x float: x + (available - metrics[3]) / 2.0
    return: this.faded_line(buffer, at, value, centered_x, y, metrics[3] + this.styles.safe_inset(), metrics[2], cap, fade)

  # Fade bands preserve a single font shader and avoid font-cache churn.
  fn faded_line(buffer, at, value, x, y, available, height, cap, fade):
    set metrics: this.styles.metrics(value, available, height, cap, "title")
    if: metrics[4] < 1
      return: at
    set start int: at
    set at: this.menu_line(buffer, at, value, x, y, metrics[4], metrics[0], metrics[2], metrics[1])
    if: fade > 0
      set k int: start
      while: k < at
        set buffer[k + 2]: buffer[k + 2] + 768 * fade
        set k: k + 3
    return: at

  # The headline and drawers have independent roles and measured widths.
  # Do not spread letters across the available button or label width.
  fn menu_vertices(router):
    set buffer: array(5400, 0.0)
    set at int: 0
    set screen: router.screen()
    if: screen == "menu"
      return: this.role_gold(buffer, at, "LEVEL UP!", 0.0 - 0.38, 0.47, 0.76, "hero", 10)
    if: screen == "activities"
      return: this.role_gold(buffer, at, "LEVEL UP!", 0.0 - 0.38, 0.47, 0.76, "hero", 10)
    set at: this.role_line(buffer, at, router.title(), 0.0 - 0.31, 0.47, 0.62, "drawer_title", 0.0, 24, 0, 1)
    set at: this.role_line(buffer, at, router.subtitle(), 0.0 - 0.38, 0.19, 0.76, "drawer_subtitle", 0.0, 50, 0, 1)
    set at: this.role_line(buffer, at, router.status, 0.0 - 0.38, 0.06, 0.76, "drawer_status", 0.0, 48, 0, 1)
    set opts: router.options()
    set prefixes: ["W ", "A ", "S ", "D "]
    set i int: 0
    while: i < 4
      set at: this.role_line(buffer, at, prefixes[i] + opts[i], 0.0 - 0.345, (0.0 - 0.13) - i * 0.15, 0.69, "drawer_option", 0.0, 42, 0, 0)
      set i: i + 1
    return: buffer

  # Every visible card has TWO reserved text rows: skill category and
  # fantasy title. The level badge is separate. Even the full 17-character
  # CHEST MANAGEMENT name fits without colliding with LVL 1.
  fn rich_card_text_vertices(carousel, cards, layout):
    set buffer: array(7200, 0.0)
    set at int: 0
    set i int: 0
    while: i < 7
      set rel float: carousel.visual_relative(i)
      set rect: layout.card_rect(rel)
      if: rect[2] > 0.0
        set slot int: carousel.visual_slot(i)
        set x float: rect[0]
        set y float: rect[1]
        set w float: rect[2]
        set h float: rect[3]
        set dist float: rel
        if: dist < 0.0
          set dist: 0.0 - dist
        set fade int: 0
        if: dist > 1.53
          set fade: 2
        else:
          if: dist > 0.53
            set fade: 1
        # Visual hierarchy matches React SkillCard.jsx: a small
        # uppercase category, a legible VT323 fantasy name in Title Case,
        # and an independent level badge. Far cards are summarized instead
        # of shrinking long headings into unreadable 5px glyphs.
        set at: this.role_line(buffer, at, cards.category(slot), x + 0.020, y + h - 0.048, w - 0.146, "category", dist, 15, fade, 0)
        set first: cards.display_title_first(slot)
        set second: cards.display_title_second(slot)
        if: second == ""
          set at: this.role_line(buffer, at, first, x + 0.020, y + h - 0.116, w - 0.146, "title", dist, 22, fade, 0)
        else:
          set at: this.role_line(buffer, at, first, x + 0.020, y + h - 0.094, w - 0.146, "title_wrap", dist, 22, fade, 0)
          if: fade < 2
            set at: this.role_line(buffer, at, second, x + 0.020, y + h - 0.138, w - 0.146, "title_wrap", dist, 22, fade, 0)
        set at: this.role_line(buffer, at, "Lvl " + str(cards.level(slot)), x + w - 0.105, y + h - 0.085, 0.091, "badge", dist, 9, fade, 1)

        # Every visible card gets a readable centered mob and CTA, but
        # descriptions and HP measurements are restricted to the hero card.
        set at: this.role_line(buffer, at, cards.mob_name(slot), x + w * 0.18, y + h * 0.477, w * 0.64, "mob", dist, 24, fade, 1)
        if: dist < 0.53
          set at: this.role_line(buffer, at, cards.hp_text(slot), x + 0.035, y + h * 0.416, w - 0.070, "hp", dist, 20, 0, 0)
          set at: this.role_line(buffer, at, cards.description_a(slot), x + 0.031, y + 0.298, w - 0.062, "description", dist, 25, 0, 1)
          set at: this.role_line(buffer, at, cards.description_b(slot), x + 0.031, y + 0.234, w - 0.062, "description", dist, 25, 0, 1)
        set at: this.role_line(buffer, at, cards.action(slot), x + 0.045, y + 0.082, w - 0.090, "button", dist, 15, fade, 1)
      set i: i + 1
    return: buffer

  # Draw an explicit word-copy prompt; original Writing image clues are
  # not in this prototype. Use the existing bitmap glyphs and four cards.
  fn writing_vertices(battle, spelling):
    set buffer: array(4320, 0.0)
    set at int: 0
    set status: "LVL " + str(battle.game.hero.lvl()) + "  MOB " + str(battle.game.mob.cur_hp()) + "/" + str(battle.game.mob.max_hp())
    set at: this.line(buffer, at, status, 0.0 - 0.93, 0.86, 45)
    set at: this.line(buffer, at, "COPY WORD " + battle.game.problem.ask(), 0.0 - 0.93, 0.69, 45)
    set at: this.line(buffer, at, "TYPED " + spelling.text, 0.0 - 0.93, 0.48, 45)
    set at: this.line(buffer, at, "LEFT RIGHT PAGES " + str(spelling.page + 1) + "/7", 0.0 - 0.93, 0.34, 45)
    set options: spelling.options()
    set at: this.line(buffer, at, "W  " + options[0], 0.0 - 0.88, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "A  " + options[1], 0.09, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "S  " + options[2], 0.0 - 0.88, 0.0 - 0.94, 20)
    set at: this.line(buffer, at, "D  " + options[3], 0.09, 0.0 - 0.94, 20)
    return: buffer

  # Task-specific HUD shares the original GPU bitmap font and four cards.
  fn cleaning_vertices(battle, activity):
    set buffer: array(4320, 0.0)
    set at int: 0
    set status: "LVL " + str(battle.game.hero.lvl()) + "  CHEST " + str(battle.game.mob.cur_hp()) + "/" + str(battle.game.mob.max_hp())
    set at: this.line(buffer, at, status, 0.0 - 0.93, 0.86, 45)
    set at: this.line(buffer, at, "TASK " + upper(battle.game.problem.ask()), 0.0 - 0.93, 0.69, 45)
    set at: this.line(buffer, at, "CONTAINER " + upper(battle.game.skill.chest_name()), 0.0 - 0.93, 0.51, 45)
    set at: this.line(buffer, at, activity.status, 0.0 - 0.93, 0.35, 45)
    set options: activity.options()
    set at: this.line(buffer, at, "W  " + options[0], 0.0 - 0.88, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "A  " + options[1], 0.09, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "S  " + options[2], 0.0 - 0.88, 0.0 - 0.94, 20)
    set at: this.line(buffer, at, "D  " + options[3], 0.09, 0.0 - 0.94, 20)
    return: buffer

  # Reuse four OW Graphics answer cards to display a two-page Memory board.
  # Faces come ONLY from MemorySkill.face, which hides unrevealed values.
  fn memory_vertices(battle, activity):
    set buffer: array(4320, 0.0)
    set at int: 0
    set status: "LVL " + str(battle.game.hero.lvl()) + "  MOB " + str(battle.game.mob.cur_hp()) + "/" + str(battle.game.mob.max_hp())
    set at: this.line(buffer, at, status, 0.0 - 0.93, 0.86, 45)
    set at: this.line(buffer, at, "MEMORY  PAIRS " + str(activity.matches) + "/4  BOARDS " + str(activity.boards), 0.0 - 0.93, 0.69, 45)
    set at: this.line(buffer, at, "LEFT RIGHT PAGES " + str(activity.page + 1) + "/2", 0.0 - 0.93, 0.51, 45)
    set at: this.line(buffer, at, activity.status, 0.0 - 0.93, 0.35, 45)
    set cards: activity.visible_cards()
    set start int: activity.page * 4
    set at: this.line(buffer, at, "W " + str(start + 1) + " " + cards[0], 0.0 - 0.88, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "A " + str(start + 2) + " " + cards[1], 0.09, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "S " + str(start + 3) + " " + cards[2], 0.0 - 0.88, 0.0 - 0.94, 20)
    set at: this.line(buffer, at, "D " + str(start + 4) + " " + cards[3], 0.09, 0.0 - 0.94, 20)
    return: buffer

  # A two-phase Patterns HUD, built with the existing 5x7 bitmap renderer:
  # source sequence is shown in STUDY, then hidden in RECALL. This is a
  # text sequence-completion adapter, NOT timed flashing Simon-Says parity.
  fn patterns_vertices(battle, activity):
    set buffer: array(4320, 0.0)
    set at int: 0
    set status: "LVL " + str(battle.game.hero.lvl()) + "  MOB " + str(battle.game.mob.cur_hp()) + "/" + str(battle.game.mob.max_hp())
    set at: this.line(buffer, at, status, 0.0 - 0.93, 0.86, 45)
    if: activity.phase == 0
      set at: this.line(buffer, at, "STUDY THE PATTERN", 0.0 - 0.93, 0.73, 45)
    else:
      set at: this.line(buffer, at, "RECALL THE NEXT COLOR", 0.0 - 0.93, 0.73, 45)
    set prompt: activity.shown_pattern()
    set at: this.line(buffer, at, substr(prompt, 0, 39), 0.0 - 0.93, 0.60, 39)
    if: len(prompt) > 39
      set at: this.line(buffer, at, substr(prompt, 39, 39), 0.0 - 0.93, 0.49, 39)
    set at: this.line(buffer, at, activity.status, 0.0 - 0.93, 0.33, 45)
    set options: activity.options()
    set at: this.line(buffer, at, "W " + options[0], 0.0 - 0.88, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "A " + options[1], 0.09, 0.0 - 0.75, 20)
    set at: this.line(buffer, at, "S " + options[2], 0.0 - 0.88, 0.0 - 0.94, 20)
    set at: this.line(buffer, at, "D " + options[3], 0.09, 0.0 - 0.94, 20)
    return: buffer
