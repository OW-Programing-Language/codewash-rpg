# Native pointer state for CodeWash RPG. No web, Electron or GPU dependency.
# Hit testing uses the same OpenGL NDC card geometry as the renderer:
#  1 = centered card / Play; 2 = previous; 3 = next; 10..13 = quick menu.
# Returns -1 outside interactive controls. The GLFW bridge must preserve
# off-window coordinates rather than clamping to the closest control.
class NativeMenuPointer:
  field hovered
  field visual
  field eased
  field held

  fn new():
    set this.hovered: 0 - 1
    set this.visual: 0 - 1
    set this.eased: 0.0
    set this.held: 0

  fn inside(x, y, left, bottom, width, height):
    if: x < left
      return: 0
    if: x > left + width
      return: 0
    if: y < bottom
      return: 0
    if: y > bottom + height
      return: 0
    return: 1

  fn hit(x, y, screen, carousel, layout):
    if: x < 0.0 - 1.0
      return: 0 - 1
    if: x > 1.0
      return: 0 - 1
    if: y < 0.0 - 1.0
      return: 0 - 1
    if: y > 1.0
      return: 0 - 1
    if: screen != "menu"
      if: screen != "activities"
        if: screen != "settings"
          return: 0 - 1

    # Footer action buttons are usable on all native menu pages.
    set i int: 0
    while: i < 4
      if: this.inside(x, y, layout.button_x(i), layout.button_y(), layout.button_width(), layout.button_height()) == 1
        return: 10 + i
      set i: i + 1
    if: screen == "settings"
      return: 0 - 1
    # Reject clicks mid-transition, matching keyboard navigation lock.
    if: carousel.active == 1
      return: 0 - 1

    # Dedicated previous / next chevrons take priority over side cards.
    if: this.inside(x, y, 0.0 - 0.995, 0.0 - 0.20, 0.110, 0.30) == 1
      return: 2
    if: this.inside(x, y, 0.885, 0.0 - 0.20, 0.110, 0.30) == 1
      return: 3

    set i: 0
    while: i < 7
      set rel float: carousel.visual_relative(i)
      set rect: layout.card_rect(rel)
      if: rect[2] > 0.0
        if: this.inside(x, y, rect[0], rect[1], rect[2], rect[3]) == 1
          if: rel < 0.0 - 0.5
            return: 2
          if: rel > 0.5
            return: 3
          return: 1
      set i: i + 1
    return: 0 - 1

  # Rising-edge-only actions. Dragging onto an active element while held
  # cannot activate it; releasing then pressing can.
  fn sample(x, y, down, screen, carousel, layout):
    set this.hovered: this.hit(x, y, screen, carousel, layout)
    if: down == 0
      set this.held: 0
      return: 0 - 1
    if: this.held == 1
      return: 0 - 1
    set this.held: 1
    return: this.hovered

  # Ease hover outline in/out over five presented frames, without rebuilding
  # any texture or touching the carousel animation clock.
  fn tick():
    if: this.hovered != this.visual
      if: this.hovered >= 0
        set this.visual: this.hovered
        set this.eased: 0.0
      else:
        if: this.eased > 0.0
          set this.eased: this.eased - 0.2
          if: this.eased <= 0.0
            set this.eased: 0.0
            set this.visual: 0 - 1
          return: 1
        set this.visual: 0 - 1
    if: this.visual >= 0
      if: this.eased < 1.0
        set this.eased: this.eased + 0.2
        if: this.eased > 1.0
          set this.eased: 1.0
        return: 1
    return: 0
