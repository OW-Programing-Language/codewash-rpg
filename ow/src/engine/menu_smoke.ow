# Real OpenGL HUD + OW Engine scene router under Mesa/Xvfb.
import "GpuBattle.ow"

main:
  set preview: new GpuBattle()
  call: assert(preview.start() == 1, "native preview starts at menu")
  call: assert(preview.menu.screen() == "menu", "initial native menu")
  call: assert(preview.art.menu_theme > 0, "original background texture decoded")
  call: assert(preview.render() == 0, "textured main menu has no battle meshes")
  call: assert(preview.art.menu_ticks == 1, "menu background animation advanced")
  set selected: extension("codewash.test.pixel", 160, 94)
  set plain: extension("codewash.test.pixel", 470, 94)
  call: assert(selected[1] > plain[1] + 30, "selected menu option visible")
  call: assert(preview.menu.choose(1) == 1, "open activity selector")
  call: assert(preview.hud.refresh_menu(preview.menu) == 1, "refresh activity page")
  call: assert(preview.render() == 0, "textured activity screen has no battle meshes")
  call: assert(preview.art.menu_ticks == 2, "menu animation survives page transition")
  call: assert(preview.menu.choose(1) == 1, "Reading now playable")
  call: assert(preview.menu.screen() == "reading", "native reading scene")
  call: assert(preview.hud.refresh(preview.reading) == 1, "reading text and choices")
  call: assert(preview.render() == 4, "reading scene has four active meshes")
  call: assert(preview.menu.back() == 1, "return from reading")
  call: assert(preview.menu.open_activities(0) == 1, "back to activities")
  call: assert(preview.menu.choose(2) == 1, "Writing now playable")
  call: assert(preview.menu.screen() == "writing", "native Writing scene")
  call: assert(preview.hud.refresh_writing(preview.writing, preview.spelling) == 1, "writing virtual keyboard")
  call: assert(preview.render() == 4, "Writing scene has four active meshes")
  call: assert(preview.menu.back() == 1, "return from Writing")
  call: assert(preview.menu.open_activities(0) == 1, "back to activities")
  call: assert(preview.menu.choose(3) == 1, "next activity page")
  call: assert(preview.menu.activity_page == 1, "reading all six activities")
  call: assert(preview.menu.choose(0) == 1, "Cleaning now playable")
  call: assert(preview.menu.screen() == "cleaning", "native cleaning scene")
  call: assert(preview.hud.refresh_cleaning(preview.cleaning, preview.cleaning_activity) == 1, "cleaning task HUD")
  call: assert(preview.render() == 4, "Cleaning has four ECS meshes")
  call: assert(preview.menu.back() == 1, "leave Cleaning")
  call: assert(preview.menu.open_activities(1) == 1, "activities page two")
  call: assert(preview.menu.choose(1) == 1, "Memory now playable")
  call: assert(preview.menu.screen() == "memory", "Memory scene")
  call: assert(preview.hud.refresh_memory(preview.memory, preview.memory_activity) == 1, "Memory card HUD")
  call: assert(preview.render() == 4, "Memory has four ECS meshes")
  call: assert(preview.menu.back() == 1, "leave Memory")
  call: assert(preview.menu.open_activities(1) == 1, "back to activities page 2")
  call: assert(preview.menu.choose(2) == 1, "Patterns now playable")
  call: assert(preview.menu.screen() == "patterns", "native Patterns scene")
  call: assert(preview.hud.refresh_patterns(preview.patterns, preview.patterns_activity) == 1, "Patterns study HUD")
  call: assert(preview.render() == 4, "Patterns has four ECS battle meshes")
  call: assert(preview.menu.back() == 1, "leave Patterns")
  call: assert(preview.menu.screen() == "menu", "Patterns returns to main menu")
  call: assert(preview.menu.back() == 1, "back to menu")
  call: assert(preview.menu.choose(2) == 1, "settings screen")
  call: assert(preview.hud.refresh_menu(preview.menu) == 1, "refresh settings screen")
  call: assert(preview.render() == 0, "settings no battle")
  call: assert(preview.menu.choose(3) == 1, "return menu from settings")
  call: assert(preview.menu.choose(0) == 1, "start existing math")
  call: assert(preview.hud.refresh(preview.battle) == 1, "battle HUD")
  call: assert(preview.render() == 4, "battle ECS resumes")
  set hero: extension("codewash.test.pixel", 498, 360)
  call: assert(hero[2] > hero[0] + 30, "hero appears in math scene")
  call: assert(preview.menu.back() == 1, "leave math")
  call: assert(preview.hud.refresh_menu(preview.menu) == 1, "menu HUD restored")
  call: assert(preview.render() == 0, "battle 3D objects hidden on menu")
  call: assert(preview.stop() == 1, "all GPU objects cleaned up")
  call: assert(preview.art.menu_theme == 0, "menu theme texture freed")
  print: "PASS: native OW menu, six activity slots, settings and math routing"
