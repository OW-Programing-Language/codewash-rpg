# A real native Reading choice rendered by OW Engine and OW Graphics.
# Framebuffer samples verify both the word HUD and the independent ECS scene.
import "GpuBattle.ow"

main:
  set game: new GpuBattle()
  call: assert(game.start() == 1, "OpenGL native Reading boot")
  call: assert(game.menu.screen() == "menu", "menu is initial screen")
  call: assert(game.menu.open_activities(0) == 1, "open activity selector")
  call: assert(game.menu.choose(1) == 1, "select Reading activity")
  call: assert(game.menu.screen() == "reading", "real reading scene active")
  call: assert(game.reading.skill_name == "reading", "reading uses original skill")
  call: assert(game.hud.refresh(game.reading) == 1, "word and options sent to GPU")
  call: assert(game.render() == 4, "four reading ECS battle meshes")
  set readingHeader: extension("codewash.test.pixel", 48, 615)
  call: assert(readingHeader[0] > 150, "READING word glyphs rasterized")
  set hero: extension("codewash.test.pixel", 450, 360)
  call: assert(hero[2] > hero[0] + 30, "cyan reading hero drawn")
  set selected: extension("codewash.test.pixel", 320, 98)
  set ordinary: extension("codewash.test.pixel", 960, 98)
  call: assert(selected[1] > ordinary[1] + 30, "Reading answer card highlight")

  set initial: game.reading.options()
  call: assert(game.reading.game.problem.solution() == initial[1], "answer A is target")
  call: assert(game.reading.options()[0] == initial[0], "word distractors remain stable")
  set mathHp int: game.battle.game.mob.cur_hp()
  set hp int: game.reading.game.mob.cur_hp()
  call: assert(game.reading.choose(0) == 0, "wrong word choice")
  call: assert(game.reading.game.mob.cur_hp() == hp, "wrong word does not damage")
  call: assert(game.reading.game.problem.solution() == game.reading.options()[1], "question advanced")
  call: assert(game.hud.refresh(game.reading) == 1, "wrong answer refreshes text")
  call: assert(game.render() == 5, "pink miss effect in Reading")
  set miss: extension("codewash.test.pixel", 450, 555)
  call: assert(miss[0] > miss[1] + 60, "pink miss GPU pixel")
  call: assert(game.reading.choose(1) == 1, "correct word choice")
  call: assert(game.reading.game.mob.cur_hp() < hp, "correct word damages Reading foe")
  call: assert(game.hud.refresh(game.reading) == 1, "correct answer refreshes text")
  call: assert(game.render() == 5, "gold hit effect in Reading")
  set hit: extension("codewash.test.pixel", 830, 555)
  call: assert(hit[0] > 120, "gold reading hit GPU pixel")
  call: assert(hit[1] > 95, "gold reading hit green")
  call: assert(game.battle.game.mob.cur_hp() == mathHp, "Math run independent")

  set readingHp int: game.reading.game.mob.cur_hp()
  call: assert(game.menu.back() == 1, "back to menu")
  call: assert(game.hud.refresh_menu(game.menu) == 1, "menu HUD restored")
  call: assert(game.render() == 0, "no Reading or Math meshes on menu")
  call: assert(game.menu.start_math() == 1, "start preserved Math run")
  call: assert(game.hud.refresh(game.battle) == 1, "math HUD returns")
  call: assert(game.render() == 4, "Math battle visible")
  call: assert(game.menu.start_reading() == 1, "resume Reading scene")
  call: assert(game.hud.refresh(game.reading) == 1, "Reading HUD returns")
  call: assert(game.reading.game.mob.cur_hp() == readingHp, "Reading HP preserved")
  call: assert(game.stop() == 1, "both game sessions and GPU resources cleaned up")
  print: "PASS: independent OW Reading activity, word HUD and native GPU feedback"
