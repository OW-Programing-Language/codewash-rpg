# Pure OW geometry contract for the first wide-screen CodeWash menu.
# OW Graphics' pinned window API only has open(width,height), not resize or
# fullscreen. Keep the game 16:9 and express chrome anchors in clip space;
# a resizable/fullscreen API remains a later OW Graphics improvement.
class NativeMenuLayout:
  fn width():
    return: 1280

  fn height():
    return: 720

  fn aspect():
    return: 16.0 / 9.0

  fn logo_x():
    return: 0.0 - 0.54

  fn logo_y():
    return: 0.64

  fn panel_x(index):
    if: index == 0
      return: 0.0 - 0.88
    if: index == 1
      return: 0.0 - 0.27
    if: index == 2
      return: 0.49
    return: 0.0

  fn panel_width(index):
    if: index == 1
      return: 0.54
    return: 0.39

  fn panel_y(index):
    if: index == 1
      return: 0.0 - 0.51
    return: 0.0 - 0.47

  fn panel_height(index):
    if: index == 1
      return: 0.88
    return: 0.80

  fn button_x(index):
    return: (0.0 - 0.96) + index * 0.48

  fn button_y():
    return: 0.0 - 0.83

  fn button_vertices():
    set buffer: array(72, 0.0)
    set i int: 0
    while: i < 4
      set x float: this.button_x(i)
      set y float: this.button_y()
      set w float: 0.43
      set h float: 0.17
      set z int: 0 - 1 - i
      set at int: i * 18
      set buffer[at]: x
      set buffer[at + 1]: y
      set buffer[at + 2]: z
      set buffer[at + 3]: x + w
      set buffer[at + 4]: y
      set buffer[at + 5]: z
      set buffer[at + 6]: x + w
      set buffer[at + 7]: y + h
      set buffer[at + 8]: z
      set buffer[at + 9]: x
      set buffer[at + 10]: y
      set buffer[at + 11]: z
      set buffer[at + 12]: x + w
      set buffer[at + 13]: y + h
      set buffer[at + 14]: z
      set buffer[at + 15]: x
      set buffer[at + 16]: y + h
      set buffer[at + 17]: z
      set i: i + 1
    return: buffer
