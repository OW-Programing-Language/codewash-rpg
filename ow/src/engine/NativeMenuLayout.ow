# Pure OW geometry contract for the first wide-screen CodeWash menu.
# OW Graphics' pinned window API only has open(width,height), not resize or
# fullscreen. Keep the game 16:9 and express chrome anchors in clip space;
# a resizable/fullscreen API remains a later OW Graphics improvement.
class NativeMenuLayout:
  fn width():
    return: 1280

  fn height():
    return: 720

  fn aspect():
    return: 16.0 / 9.0

  fn logo_x():
    return: 0.0 - 0.54

  fn logo_y():
    return: 0.64

  fn panel_x(index):
    if: index == 0
      return: 0.0 - 0.88
    if: index == 1
      return: 0.0 - 0.27
    if: index == 2
      return: 0.49
    return: 0.0

  fn panel_width(index):
    if: index == 1
      return: 0.54
    return: 0.39

  fn panel_y(index):
    if: index == 1
      return: 0.0 - 0.51
    return: 0.0 - 0.47

  fn panel_height(index):
    if: index == 1
      return: 0.88
    return: 0.80

  # Compact top-corner actions instead of four huge footer rectangles.
  fn button_x(index):
    if: index == 0
      return: 0.0 - 0.963
    if: index == 1
      return: 0.0 - 0.820
    if: index == 2
      return: 0.715
    return: 0.857

  fn button_y():
    return: 0.78

  fn button_width():
    return: 0.106

  fn button_height():
    return: 0.137

  # Quad writer for the native UI geometry. Z encodes themed GPU colors.
  # The HUD's shader is shared with the original OW bitmap glyph renderer.
  fn quad(buffer, at, x, y, w, h, z):
    set buffer[at]: x
    set buffer[at + 1]: y
    set buffer[at + 2]: z
    set buffer[at + 3]: x + w
    set buffer[at + 4]: y
    set buffer[at + 5]: z
    set buffer[at + 6]: x + w
    set buffer[at + 7]: y + h
    set buffer[at + 8]: z
    set buffer[at + 9]: x
    set buffer[at + 10]: y
    set buffer[at + 11]: z
    set buffer[at + 12]: x + w
    set buffer[at + 13]: y + h
    set buffer[at + 14]: z
    set buffer[at + 15]: x
    set buffer[at + 16]: y + h
    set buffer[at + 17]: z
    return: at + 18

  # 3 framed feature cards, 4 top-corner action ornaments, and a decorative
  # 10-heart health strip. No false claim of active mouse controls.
  fn chrome_vertices():
    set buffer: array(1728, 0.0)
    set at int: 0
    # Top-corner icon drop shadows and unchanged ten-pixel-heart strip.
    set i int: 0
    while: i < 4
      set at: this.quad(buffer, at, this.button_x(i) + 0.006, this.button_y() - 0.008, this.button_width(), this.button_height(), 0 - 10)
      set i: i + 1
    set i: 0
    while: i < 10
      set hx float: (0.0 - 0.42) + i * 0.087
      set hy float: 0.0 - 0.97
      set at: this.quad(buffer, at, hx, hy, 0.066, 0.072, 0 - 10)
      set at: this.quad(buffer, at, hx + 0.007, hy + 0.042, 0.021, 0.025, 0 - 8)
      set at: this.quad(buffer, at, hx + 0.038, hy + 0.042, 0.021, 0.025, 0 - 8)
      set at: this.quad(buffer, at, hx + 0.009, hy + 0.023, 0.049, 0.029, 0 - 8)
      set at: this.quad(buffer, at, hx + 0.020, hy + 0.010, 0.028, 0.020, 0 - 8)
      set i: i + 1
    return: buffer


  # Reference screenshot geometry: five visible cards, a tall focused
  # portrait, and diminishing, darkened neighbors at +/-1 and +/-2.
  # NDC coordinates are shared with pointer hit-testing and texture quads.
  # Seven potential cards are sampled during transitions so incoming edge
  # cards do not pop into view when the carousel rebases.
  fn card_rect(relative):
    set distance float: relative
    if: distance < 0.0
      set distance: 0.0 - distance
    if: distance > 2.65
      return: [0.0, 0.0, 0.0, 0.0]
    if: distance > 2.0
      set distance: 2.0
    set width float: 0.352 - 0.055 * distance
    set height float: 1.19 - 0.175 * distance
    set x float: 0.352 * relative - width / 2.0
    set y float: (0.0 - 0.19) - height / 2.0
    return: [x, y, width, height]

  # Color-banded glow + shadow, with bright gold focus ring. Keep all
  # visual geometry generated in native OW and drawn with OpenGL shaders.
  fn carousel_vertices(carousel):
    set buffer: array(1008, 0.0)
    set at int: 0
    set i int: 0
    while: i < 7
      set rel float: carousel.visual_relative(i)
      set rect: this.card_rect(rel)
      if: rect[2] > 0.0
        set dist float: rel
        if: dist < 0.0
          set dist: 0.0 - dist
        set x float: rect[0]
        set y float: rect[1]
        set w float: rect[2]
        set h float: rect[3]
        set border int: 0 - 10
        set body int: 0 - 5
        set thick float: 0.006
        if: dist < 0.52
          set border: 0 - 7
          set body: 0 - 6
          set thick: 0.009
          # Large dim gold ring and smaller luminous rim.
          set at: this.quad(buffer, at, x - 0.024, y - 0.024, w + 0.048, h + 0.048, 0 - 19)
          set at: this.quad(buffer, at, x - 0.014, y - 0.014, w + 0.028, h + 0.028, 0 - 18)
        else:
          set at: this.quad(buffer, at, x + 0.012, y - 0.012, w, h, 0 - 10)
        set at: this.quad(buffer, at, x - thick, y - thick, w + thick * 2.0, h + thick * 2.0, border)
        set at: this.quad(buffer, at, x, y, w, h, body)
      set i: i + 1
    return: buffer

  # Cards from PR #33 keep their exact eased geometry. Rich data overlays
  # follow the same card_rect() so colored title strips, HP bars and action
  # buttons move and scale together with the already animated frame/portrait.
  #
  # Negative vertex Z = a material index in BattleHud's OpenGL shader:
  # -11..-16 activity-specific accents; -8 red HP; -9 charcoal; -10 ink.
  fn rich_card_vertices(carousel, cards):
    set buffer: array(1800, 0.0)
    set at int: 0
    set i int: 0
    while: i < 7
      set rel float: carousel.visual_relative(i)
      set rect: this.card_rect(rel)
      if: rect[2] > 0.0
        set slot int: carousel.visual_slot(i)
        set x float: rect[0]
        set y float: rect[1]
        set w float: rect[2]
        set h float: rect[3]
        set accent int: (0 - 11) - slot
        # Colored Minecraft-style header and dark level badge.
        set at: this.quad(buffer, at, x, y + h - 0.115, w, 0.115, accent)
        set at: this.quad(buffer, at, x + w - 0.132, y + h - 0.103, 0.122, 0.087, 0 - 10)
        # Dark inset for the current real mob portrait.
        set at: this.quad(buffer, at, x + 0.04, y + h * 0.45, w - 0.08, h * 0.36, 0 - 5)
        # Current mob-name backing and black HP rail.
        set at: this.quad(buffer, at, x + 0.021, y + 0.305, w - 0.042, 0.072, 0 - 9)
        set at: this.quad(buffer, at, x + 0.025, y + 0.245, w - 0.050, 0.046, 0 - 9)
        set hp float: cards.hp_percent(slot)
        if: hp > 0.0
          set at: this.quad(buffer, at, x + 0.030, y + 0.250, (w - 0.060) * hp / 100.0, 0.036, 0 - 8)
        # Original-themed text panel and elevated colored CTA.
        set at: this.quad(buffer, at, x + 0.019, y + 0.106, w - 0.038, 0.123, 0 - 9)
        set at: this.quad(buffer, at, x + 0.025, y + 0.015, w - 0.050, 0.082, 0 - 10)
        set at: this.quad(buffer, at, x + 0.025, y + 0.026, w - 0.050, 0.082, accent)
      set i: i + 1
    return: buffer

  # Two visible previous/next chevrons outside the animated cards.
  # Match the pointer hitboxes in NativeMenuPointer exactly.
  fn triangle(buffer, at, x1, y1, x2, y2, x3, y3, z):
    set buffer[at]: x1
    set buffer[at + 1]: y1
    set buffer[at + 2]: z
    set buffer[at + 3]: x2
    set buffer[at + 4]: y2
    set buffer[at + 5]: z
    set buffer[at + 6]: x3
    set buffer[at + 7]: y3
    set buffer[at + 8]: z
    return: at + 9

  fn arrow_vertices():
    set buffer: array(54, 0.0)
    set at int: 0
    set at: this.quad(buffer, at, 0.0 - 0.973, 0.0 - 0.24, 0.005, 0.44, 0 - 7)
    set at: this.quad(buffer, at, 0.968, 0.0 - 0.24, 0.005, 0.44, 0 - 7)
    set at: this.triangle(buffer, at, 0.0 - 0.970, 0.0 - 0.05, 0.0 - 0.910, 0.02, 0.0 - 0.910, 0.0 - 0.12, 0 - 7)
    set at: this.triangle(buffer, at, 0.970, 0.0 - 0.05, 0.910, 0.02, 0.910, 0.0 - 0.12, 0 - 7)
    return: buffer

  # GPU-only glow outline. Pointer easing expands the ring over five frames
  # and material #16 pulses in the fragment shader. No web shadows / CSS.
  # Regenerate only while hovered or while the card is already animating.
  fn hover_vertices(pointer, carousel):
    set buffer: array(72, 0.0)
    if: pointer.visual < 0
      return: buffer
    set x float: 0.0
    set y float: 0.0
    set w float: 0.0
    set h float: 0.0
    set target int: pointer.visual
    if: target >= 10
      if: target <= 13
        set x: this.button_x(target - 10)
        set y: this.button_y()
        set w: this.button_width()
        set h: this.button_height()
    else:
      if: target == 2
        set x: 0.0 - 0.995
        set y: 0.0 - 0.20
        set w: 0.110
        set h: 0.30
      else:
        if: target == 3
          set x: 0.885
          set y: 0.0 - 0.20
          set w: 0.110
          set h: 0.30
        else:
          if: target == 1
            set i int: 0
            while: i < 7
              set rel float: carousel.visual_relative(i)
              if: rel >= 0.0 - 0.5
                if: rel <= 0.5
                  set rect: this.card_rect(rel)
                  set x: rect[0]
                  set y: rect[1]
                  set w: rect[2]
                  set h: rect[3]
              set i: i + 1
    if: w <= 0.0
      return: buffer
    set t float: 0.003 + 0.011 * pointer.eased
    set at int: 0
    set at: this.quad(buffer, at, x - t, y - t, w + t * 2.0, t, 0 - 17)
    set at: this.quad(buffer, at, x - t, y + h, w + t * 2.0, t, 0 - 17)
    set at: this.quad(buffer, at, x - t, y, t, h, 0 - 17)
    set at: this.quad(buffer, at, x + w, y, t, h, 0 - 17)
    return: buffer

  fn button_vertices():
    set buffer: array(72, 0.0)
    set at int: 0
    set i int: 0
    while: i < 4
      set at: this.quad(buffer, at, this.button_x(i), this.button_y(), this.button_width(), this.button_height(), 0 - 5)
      set i: i + 1
    return: buffer
