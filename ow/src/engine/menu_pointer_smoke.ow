# Mesa/Xvfb real OpenGL proof of clickable geometry and shader hover pulse.
# Synthetic NDC pointer samples exercise the exact controller used by poll().
import "GpuBattle.ow"

main:
  set game: new GpuBattle()
  call: assert(game.start() == 1, "native OW pointer UI starts")
  call: assert(game.hud.arrow_controls > 0, "arrow GPU mesh exists")
  call: assert(game.hud.hover_frame > 0, "hover GPU mesh exists")
  call: assert(game.render() == 0, "initial native menu draws")
  set x float: 0.0 - 0.91
  set y float: 0.85
  call: assert(game.pointer.sample(x, y, 0, game.menu.screen(), game.carousel, game.layout) == 0 - 1, "hover without click")
  set i int: 0
  while: i < 6
    call: assert(game.render() == 0, "mouse hover pulse renders")
    set i: i + 1
  call: assert(game.pointer.visual == 10, "settings icon highlighted")
  call: assert(game.pointer.eased == 1.0, "hover transition reaches full outline")
  set hover: extension("codewash.test.pixel", 50, 693)
  call: assert(hover[1] > hover[0] + 30, "cyan GPU hover outline visible at button top")
  call: assert(game.pointer.sample(x, y, 1, game.menu.screen(), game.carousel, game.layout) == 10, "left click selects settings icon")
  call: assert(game.pointer.sample(x, y, 1, game.menu.screen(), game.carousel, game.layout) == 0 - 1, "held click not repeated")
  call: assert(game.pointer.sample(x, y, 0, game.menu.screen(), game.carousel, game.layout) == 0 - 1, "release resets latch")
  call: assert(game.pointer.sample(0.0, 0.0, 1, game.menu.screen(), game.carousel, game.layout) == 1, "center card is clickable")
  call: assert(game.pointer.sample(0.0, 0.0, 0, game.menu.screen(), game.carousel, game.layout) == 0 - 1, "release center")
  call: assert(game.move_carousel(1) == 1, "mouse arrow routes through existing ease")
  call: assert(game.pointer.hit(0.0, 0.0, game.menu.screen(), game.carousel, game.layout) == 0 - 1, "no click during animation")
  set i: 0
  while: i < 12
    call: assert(game.render() == 0, "carousel animation and hover meshes coexist")
    set i: i + 1
  call: assert(game.carousel.selected == 1, "focused Reading after animation")
  call: assert(game.pointer.hit(0.0, 0.0, game.menu.screen(), game.carousel, game.layout) == 1, "center hit restored")
  call: assert(game.stop() == 1, "all resources stop")
  call: assert(game.hud.arrow_controls == 0, "arrow mesh freed")
  call: assert(game.hud.hover_frame == 0, "hover mesh freed")
  print: "PASS: clickable OW menu geometry, mouse debouncing, live GPU hover outlines"
