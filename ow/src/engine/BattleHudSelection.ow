# Pure OW selection model for the native OpenGL math battle.
# W/A/S/D submits directly; arrow keys select a card, Space confirms it.
class BattleHudSelection:
  field selected

  fn new():
    set this.selected: 0

  fn pick(index):
    if: index < 0
      return: 0
    if: index > 3
      return: 0
    set this.selected: index
    return: 1

  fn move(direction):
    if: direction == "RIGHT"
      if: this.selected == 0
        set this.selected: 1
      else:
        if: this.selected == 2
          set this.selected: 3
      return: 1
    if: direction == "LEFT"
      if: this.selected == 1
        set this.selected: 0
      else:
        if: this.selected == 3
          set this.selected: 2
      return: 1
    if: direction == "DOWN"
      if: this.selected < 2
        set this.selected: this.selected + 2
      return: 1
    if: direction == "UP"
      if: this.selected > 1
        set this.selected: this.selected - 2
      return: 1
    return: 0

  fn submit(battle):
    return: battle.choose(this.selected)
