# Native Mesa proof: OW Engine battle plus real OpenGL HUD text/cards.
# The framebuffer probe is CI-only and absent from game releases.
import "GpuBattle.ow"

main:
  set game: new GpuBattle()
  call: assert(game.start() == 1, "OpenGL battle HUD boots")
  call: assert(game.menu.screen() == "menu", "initially native menu")
  call: assert(game.render() == 0, "menu scene has no 3D meshes")
  call: assert(game.menu.start_math() == 1, "select math battle")
  call: assert(game.hud.refresh(game.battle) == 1, "battle HUD displayed")
  call: assert(game.render() == 4, "battle four meshes plus separate HUD")
  set hero: extension("codewash.test.pixel", 498, 360)
  set mob: extension("codewash.test.pixel", 783, 360)
  call: assert(hero[2] > hero[0] + 30, "cyan hero")
  call: assert(mob[0] > mob[2] + 35, "orange monster")

  # HUD card backgrounds must be drawn inside the framebuffer, not terminal.
  set selected: extension("codewash.test.pixel", 320, 98)
  set ordinary: extension("codewash.test.pixel", 960, 98)
  call: assert(selected[1] > ordinary[1] + 30, "W choice highlighted")
  # The 'LVL' status line renders as real OpenGL glyphs (the VT323 atlas font).
  # Scan the top-left status band for any bright glyph pixel so the check stays
  # valid across font geometry changes instead of pinning one exact pixel.
  set found int: 0
  set sy int: 560
  while: sy < 715
    set sx int: 20
    while: sx < 360
      set probe: extension("codewash.test.pixel", sx, sy)
      if: probe[0] > 150
        set found: 1
      set sx: sx + 4
    set sy: sy + 4
  call: assert(found == 1, "top-left status text glyph is visible")

  call: assert(game.selection.move("RIGHT") == 1, "arrow navigation")
  call: assert(game.render() == 4, "HUD redraws changed selection")
  set old_card: extension("codewash.test.pixel", 320, 98)
  set current_card: extension("codewash.test.pixel", 960, 98)
  call: assert(current_card[1] > old_card[1] + 30, "A choice now highlighted")
  call: assert(game.selection.move("LEFT") == 1)

  call: assert(game.battle.choose(2) == 1, "existing math rules still apply")
  call: assert(game.hud.refresh(game.battle) == 1, "answer labels refresh")
  call: assert(game.render() == 5, "hit effect and HUD both render")
  set hit: extension("codewash.test.pixel", 783, 555)
  call: assert(hit[0] > 120, "gold hit marker red")
  call: assert(hit[1] > 95, "gold hit marker green")
  set i int: 0
  while: i < 11
    call: game.battle.advance_feedback()
    set i: i + 1
  call: assert(game.render() == 4, "hit feedback expires")

  set hp int: game.battle.game.mob.cur_hp()
  call: assert(game.battle.choose(0) == 0, "wrong math answer")
  call: assert(game.battle.game.mob.cur_hp() == hp, "wrong answer does not damage")
  call: assert(game.hud.refresh(game.battle) == 1, "second HUD refresh")
  call: assert(game.render() == 5, "miss effect and HUD both render")
  set miss: extension("codewash.test.pixel", 498, 555)
  call: assert(miss[0] > 120, "pink miss marker red")
  call: assert(miss[0] > miss[1] + 60, "pink miss marker contrasted")
  call: assert(game.stop() == 1, "HUD and world GPU handles destroyed")
  print: "PASS: native OW HUD glyphs, choices, hit and miss framebuffer pixels"
