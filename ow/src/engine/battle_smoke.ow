# Native Mesa proof: idle, hit, idle, miss, idle, with actual back-buffer pixels.
import "GpuBattle.ow"

main:
  set game: new GpuBattle()
  call: assert(game.start() == 1, "GPU battle boot")
  call: assert(game.render() == 4, "idle has four rendered meshes")
  set hero: extension("codewash.test.pixel", 225, 240)
  set mob: extension("codewash.test.pixel", 415, 240)
  call: assert(hero[2] > hero[0] + 30, "cyan hero")
  call: assert(mob[0] > mob[2] + 35, "orange monster")
  call: assert(game.battle.choose(2) == 1, "correct original OW math answer")
  call: assert(game.render() == 5, "gold hit effect visible")
  set hit: extension("codewash.test.pixel", 415, 370)
  call: assert(hit[0] > 120, "gold hit red component")
  call: assert(hit[1] > 95, "gold hit green component")
  call: assert(hit[2] < 90, "gold hit low blue component")
  set i int: 0
  while: i < 11
    call: game.battle.advance_feedback()
    set i: i + 1
  call: assert(game.battle.feedback_kind == 0, "hit effect expires")
  call: assert(game.render() == 4, "battle restored after hit")
  set health int: game.battle.game.mob.cur_hp()
  call: assert(game.battle.choose(0) == 0, "wrong original OW math answer")
  call: assert(game.battle.game.mob.cur_hp() == health, "no wrong-answer damage")
  call: assert(game.render() == 5, "pink miss effect visible")
  set miss: extension("codewash.test.pixel", 225, 370)
  call: assert(miss[0] > 120, "pink miss red component")
  call: assert(miss[0] > miss[1] + 60, "pink red exceeds green")
  call: assert(miss[2] > miss[1], "pink blue exceeds green")
  set j int: 0
  while: j < 11
    call: game.battle.advance_feedback()
    set j: j + 1
  call: assert(game.battle.feedback_kind == 0, "miss effect expires")
  call: assert(game.render() == 4, "battle restored after miss")
  call: assert(game.stop() == 1, "GPU resources freed")
  print: "PASS: OW combat hit and miss GPU framebuffer feedback"
