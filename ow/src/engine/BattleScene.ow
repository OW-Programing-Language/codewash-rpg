# OW Engine owns ECS entities/transforms and active scenes; OW Graphics
# owns mesh handles and drawing. CodeWash's existing combat service owns rules.
# No OpenGL or GLFW imports here: identical gameplay in GPU and headless tests.
import "../modules/combat/api/Game.ow"
class BattleScene:
  field app
  field scenes
  field ecs
  field world
  field game
  field hero
  field monster
  field health
  field ground
  field hit_fx
  field miss_fx
  field battle_mesh
  field feedback_kind
  field feedback_frame
  field scene_name
  field skill_name
  field cached_options

  fn new(app):
    set this.app: app
    set this.scenes: app.service("scenes")
    set this.ecs: app.service("components")
    set this.world: app.service("render_world")
    set this.game: app.service("game")
    set this.hero: 0
    set this.monster: 0
    set this.health: 0
    set this.ground: 0
    set this.hit_fx: 0
    set this.miss_fx: 0
    set this.battle_mesh: 0
    set this.feedback_kind: 0
    set this.feedback_frame: 0
    set this.scene_name: "battle"
    set this.skill_name: "math"
    set this.cached_options: []

  # Patterns has its own Game/ECS state, as every other native activity.
  fn configure_patterns():
    if: this.hero != 0
      return: 0
    set this.scene_name: "patterns"
    set this.skill_name: "patterns"
    set this.game: new Game()
    return: 1

  # Memory keeps one independent ECS Game and the original MemorySkill deck.
  fn configure_memory():
    if: this.hero != 0
      return: 0
    set this.scene_name: "memory"
    set this.skill_name: "memory"
    set this.game: new Game()
    return: 1

  # Keep Cleaning tasks and progression independent of other activities.
  fn configure_cleaning():
    if: this.hero != 0
      return: 0
    set this.scene_name: "cleaning"
    set this.skill_name: "cleaning"
    set this.game: new Game()
    return: 1

  # A separate Game and ECS scene isolate Writing progression.
  fn configure_writing():
    if: this.hero != 0
      return: 0
    set this.scene_name: "writing"
    set this.skill_name: "writing"
    set this.game: new Game()
    return: 1

  # Independent native Reading run using the existing ReadingSkill/Game API.
  # Each activity owns its own Game; paused math progress is never overwritten.
  fn configure_reading():
    if: this.hero != 0
      return: 0
    set this.scene_name: "reading"
    set this.skill_name: "reading"
    set this.game: new Game()
    return: 1

  fn start(mesh):
    if: mesh < 1
      return: 0
    if: this.hero != 0
      return: 0
    if: this.scenes.activate(this.scene_name) != 1
      return: 0
    call: this.game.use_skill(this.app.service("skills").make(this.skill_name))
    call: this.game.start(1)
    # Word distractors are randomized: freeze the four displayed choices until
    # the answer is submitted, so the HUD and combat accept the same value.
    set this.cached_options: this.game.skill.options(this.game.problem)
    set this.hero: this.scenes.spawn("hero")
    set this.monster: this.scenes.spawn("monster")
    set this.health: this.scenes.spawn("monster-health")
    set this.ground: this.scenes.spawn("battle-floor")
    set this.hit_fx: this.scenes.spawn("hit-spark")
    set this.miss_fx: this.scenes.spawn("miss-spark")
    if: this.hero == 0
      return: 0
    if: this.monster == 0
      return: 0
    if: this.health == 0
      return: 0
    if: this.ground == 0
      return: 0
    if: this.hit_fx == 0
      return: 0
    if: this.miss_fx == 0
      return: 0
    set this.battle_mesh: mesh
    call: this.ecs.set_transform(this.hero, 0.0 - 1.55, 0.0, 0.0)
    call: this.ecs.set_transform(this.monster, 1.55, 0.0, 0.0)
    call: this.ecs.set_transform(this.health, 1.55, 1.35, 0.0)
    call: this.ecs.set_transform(this.ground, 0.0, 0.0 - 1.32, 0.0 - 0.45)
    # Dormant ECS effects do not draw until a correct or wrong answer.
    call: this.ecs.set_transform(this.hit_fx, 1.55, 2.05, 0.0)
    call: this.ecs.set_transform(this.miss_fx, 0.0 - 1.55, 2.05, 0.0)
    call: this.ecs.get("transform", this.hit_fx).set_scale(0.48, 0.48, 0.48)
    call: this.ecs.get("transform", this.miss_fx).set_scale(0.48, 0.48, 0.48)
    call: this.ecs.get("transform", this.hero).set_scale(0.72, 1.0, 0.56)
    call: this.ecs.get("transform", this.monster).set_scale(0.95, 1.15, 0.72)
    call: this.ecs.get("transform", this.ground).set_scale(5.2, 0.16, 1.8)
    if: this.world.set_mesh(this.hero, mesh) != 1
      return: 0
    if: this.world.set_mesh(this.monster, mesh) != 1
      return: 0
    if: this.world.set_mesh(this.health, mesh) != 1
      return: 0
    if: this.world.set_mesh(this.ground, mesh) != 1
      return: 0
    return: this.sync_health()

  fn sync_health():
    set maximum float: 1.0 * this.game.mob.max_hp()
    if: maximum <= 0.0
      return: 0
    set ratio float: (1.0 * this.game.mob.cur_hp()) / maximum
    if: ratio < 0.0
      set ratio: 0.0
    if: ratio > 1.0
      set ratio: 1.0
    # An almost-empty bar stays visible; a defeated foe is respawned by Game.
    return: this.ecs.get("transform", this.health).set_scale(1.20 * ratio + 0.03, 0.15, 0.18)

  # Clear the effect and restore the original idle positions.
  fn clear_feedback():
    if: this.world.mesh_of(this.hit_fx) > 0
      call: this.world.clear_mesh(this.hit_fx)
    if: this.world.mesh_of(this.miss_fx) > 0
      call: this.world.clear_mesh(this.miss_fx)
    call: this.ecs.set_transform(this.hero, 0.0 - 1.55, 0.0, 0.0)
    call: this.ecs.set_transform(this.monster, 1.55, 0.0, 0.0)
    set this.feedback_kind: 0
    set this.feedback_frame: 0
    return: 1

  # 1=hit, 2=miss; only the corresponding ECS mesh is made visible.
  fn show_feedback(correct):
    call: this.clear_feedback()
    if: correct == 1
      set this.feedback_kind: 1
      return: this.world.set_mesh(this.hit_fx, this.battle_mesh)
    set this.feedback_kind: 2
    return: this.world.set_mesh(this.miss_fx, this.battle_mesh)

  # This preview animates per rendered frame; not yet real-time-scaled.
  fn advance_feedback():
    if: this.feedback_kind == 0
      return: 0
    set this.feedback_frame: this.feedback_frame + 1
    if: this.feedback_frame >= 12
      call: this.clear_feedback()
      return: 0
    if: this.feedback_kind == 1
      if: this.feedback_frame <= 4
        call: this.ecs.set_transform(this.monster, 1.72, 0.0, 0.0)
      else:
        if: this.feedback_frame <= 8
          call: this.ecs.set_transform(this.monster, 1.40, 0.0, 0.0)
        else:
          call: this.ecs.set_transform(this.monster, 1.55, 0.0, 0.0)
      call: this.ecs.set_transform(this.hit_fx, 1.55, 2.05 + 0.015 * this.feedback_frame, 0.0)
    else:
      if: this.feedback_frame <= 4
        call: this.ecs.set_transform(this.hero, 0.0 - 1.42, 0.0, 0.0)
      else:
        if: this.feedback_frame <= 8
          call: this.ecs.set_transform(this.hero, 0.0 - 1.68, 0.0, 0.0)
        else:
          call: this.ecs.set_transform(this.hero, 0.0 - 1.55, 0.0, 0.0)
      call: this.ecs.set_transform(this.miss_fx, 0.0 - 1.55, 2.05 + 0.015 * this.feedback_frame, 0.0)
    return: 1

  fn options():
    return: this.cached_options

  # 0..3 are the original MathSkill choices (W/A/S/D). Returns -1 for invalid,
  # 0 for an incorrect answer, 1 for correct. Never duplicates combat rules.
  fn choose(index):
    if: index < 0
      return: 0 - 1
    if: index > 3
      return: 0 - 1
    set answers: this.options()
    set value: answers[index]
    set correct int: 0
    if: value == this.game.problem.solution()
      set correct: 1
    call: this.game.answer(value)
    set this.cached_options: this.game.skill.options(this.game.problem)
    call: this.sync_health()
    call: this.show_feedback(correct)
    return: correct

  # Writing evaluates the entire typed word (not a four-choice answer).
  # Damage/XP/respawn still delegate to the original Game.answer().
  fn choose_text(word):
    if: this.skill_name != "writing"
      return: 0 - 1
    if: len(word) == 0
      return: 0 - 1
    set correct int: 0
    if: upper(word) == upper(this.game.problem.solution())
      set correct: 1
    call: this.game.answer(upper(word))
    set this.cached_options: this.game.skill.options(this.game.problem)
    call: this.sync_health()
    call: this.show_feedback(correct)
    return: correct

  # Only the task-mode CleaningSkill may report DONE. The separate
  # NativeCleaningActivity controller gates this behind explicit START.
  fn complete_task():
    if: this.skill_name != "cleaning"
      return: 0 - 1
    if: this.hero == 0
      return: 0 - 1
    if: this.game.skill.mode() != "task"
      return: 0 - 1
    call: this.game.answer(this.game.problem.solution())
    set this.cached_options: this.game.skill.options(this.game.problem)
    call: this.sync_health()
    call: this.show_feedback(1)
    return: 1

  # A matched pair deals one regular combat hit. Never call Game.answer("")
  # here: MemorySkill's placeholder Problem uses an empty solution, and doing
  # so would regenerate/shuffle the board after *every* pair.
  fn hit_memory():
    if: this.skill_name != "memory"
      return: 0 - 1
    if: this.hero == 0
      return: 0 - 1
    if: this.game.skill.mode() != "memory"
      return: 0 - 1
    call: this.game.hit()
    call: this.sync_health()
    call: this.show_feedback(1)
    return: 1
