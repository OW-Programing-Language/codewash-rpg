# Deterministic OW-only six-card activity carousel.
# No HTML, React, wall-clock threads or per-frame network/resource fetches.
# Smoothstep uses 12 presented frames; arrows are edge-triggered in GpuBattle.
class NativeMenuCarousel:
  field selected
  field source
  field direction
  field step
  field duration
  field active

  fn new():
    set this.selected: 0
    set this.source: 0
    set this.direction: 0
    set this.step: 0
    set this.duration: 12
    set this.active: 0

  fn name(index):
    if: index == 0
      return: "MATH"
    if: index == 1
      return: "READING"
    if: index == 2
      return: "WRITING"
    if: index == 3
      return: "CLEANING"
    if: index == 4
      return: "MEMORY"
    if: index == 5
      return: "PATTERNS"
    return: "?"

  fn focused():
    return: this.name(this.selected)

  fn page():
    if: this.selected >= 3
      return: 1
    return: 0

  fn local_slot():
    return: mod(this.selected, 3)

  # Reject a new navigation command mid-animation so GPU and UI never
  # jump between positions on a held key or a key-repeat burst.
  fn move(direction):
    if: direction != 1
      if: direction != 0 - 1
        return: 0 - 1
    if: this.active == 1
      return: 0
    set this.source: this.selected
    set this.direction: direction
    set this.selected: mod(this.selected + direction + 6, 6)
    set this.step: 0
    set this.active: 1
    return: 1

  fn jump_to(index):
    if: index < 0
      return: 0 - 1
    if: index > 5
      return: 0 - 1
    set this.selected: index
    set this.source: index
    set this.direction: 0
    set this.step: this.duration
    set this.active: 0
    return: 1

  # Returns 1 when the GPU positions change and 0 when settled.
  fn tick():
    if: this.active == 0
      return: 0
    set this.step: this.step + 1
    if: this.step >= this.duration
      set this.step: this.duration
      set this.source: this.selected
      set this.active: 0
    return: 1

  # Frame-independent sampling of cubic ease-in-out. The caller advances
  # once per rendered menu frame, never on gameplay/battle frames.
  fn progress():
    if: this.active == 0
      return: 1.0
    set t float: (1.0 * this.step) / this.duration
    return: t * t * (3.0 - 2.0 * t)

  # Five visible/culling candidates around the original selected card.
  # During a RIGHT transition all five move left continuously. At the final
  # frame the slots rebase around the new selection without a visible jump.
  fn slot(ordinal):
    if: ordinal < 0
      return: 0 - 1
    if: ordinal > 4
      return: 0 - 1
    return: mod(this.source + ordinal + 4, 6)

  fn relative(ordinal):
    if: ordinal < 0
      return: 100.0
    if: ordinal > 4
      return: 100.0
    set offset float: 1.0 * (ordinal - 2)
    if: this.active == 1
      return: offset - (this.direction * this.progress())
    return: offset

  # Select the focused skill directly, independently from the four fixed
  # quick-action hotkeys. This uses the same existing scene router methods.
  fn launch(router):
    if: this.selected == 0
      return: router.start_math()
    if: this.selected == 1
      return: router.start_reading()
    if: this.selected == 2
      return: router.start_writing()
    if: this.selected == 3
      return: router.start_cleaning()
    if: this.selected == 4
      return: router.start_memory()
    return: router.start_patterns()
