# Pure OW menu controller: OW Engine owns the scenes; UI owns input/presentation.
# Math and Reading are playable. Remaining activities are explicit previews
# until their respective native activity-porting PRs.
class NativeMenuRouter:
  field scenes
  field activity_page
  field status
  field quitting

  fn new(scenes):
    set this.scenes: scenes
    set this.activity_page: 0
    set this.status: ""
    set this.quitting: 0

  fn screen():
    return: this.scenes.active_name()

  fn open_menu():
    set this.status: ""
    return: this.scenes.activate("menu")

  fn open_activities(page):
    if: page < 0
      return: 0
    if: page > 1
      return: 0
    if: this.scenes.activate("activities") != 1
      return: 0
    set this.activity_page: page
    set this.status: "MATH AND READING READY  OTHERS SOON"
    return: 1

  fn open_settings():
    if: this.scenes.activate("settings") != 1
      return: 0
    set this.status: "SETTINGS ARE NOT IMPLEMENTED YET"
    return: 1

  fn start_math():
    if: this.scenes.activate("battle") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_reading():
    if: this.scenes.activate("reading") != 1
      return: 0
    set this.status: ""
    return: 1

  fn back():
    if: this.screen() == "menu"
      set this.quitting: 1
      return: 1
    return: this.open_menu()

  fn title():
    if: this.screen() == "battle"
      return: "MATH BATTLE"
    if: this.screen() == "reading"
      return: "READING BATTLE"
    if: this.screen() == "activities"
      if: this.activity_page == 0
        return: "ACTIVITIES  PAGE 1 OF 2"
      return: "ACTIVITIES  PAGE 2 OF 2"
    if: this.screen() == "settings"
      return: "SETTINGS PREVIEW"
    return: "CODEWASH RPG"

  fn subtitle():
    if: this.screen() == "reading"
      return: "MATCH THE WORD  FOUR CHOICES"
    if: this.screen() == "settings"
      return: "NO SETTINGS ARE ACTIVE YET"
    if: this.screen() == "activities"
      return: "SELECT AN ACTIVITY WITH W A S D"
    return: "NATIVE OW ENGINE AND GRAPHICS"

  fn options():
    if: this.screen() == "activities"
      if: this.activity_page == 0
        return: ["MATH", "READING", "WRITING", "NEXT"]
      return: ["CLEANING", "MEMORY", "PATTERNS", "BACK"]
    if: this.screen() == "settings"
      return: ["AUDIO SOON", "VIDEO SOON", "ACCESS SOON", "BACK"]
    return: ["PLAY MATH", "ACTIVITIES", "SETTINGS", "QUIT"]

  # Returns 1 for a valid routed action, 0 when no action exists, -1
  # for invalid button indices. Never starts an unported skill.
  fn choose(index):
    if: index < 0
      return: 0 - 1
    if: index > 3
      return: 0 - 1
    if: this.screen() == "menu"
      if: index == 0
        return: this.start_math()
      if: index == 1
        return: this.open_activities(0)
      if: index == 2
        return: this.open_settings()
      set this.quitting: 1
      return: 1
    if: this.screen() == "settings"
      if: index == 3
        return: this.open_menu()
      set this.status: "COMING SOON  FEATURE NOT AVAILABLE"
      return: 0
    if: this.screen() == "activities"
      if: this.activity_page == 0
        if: index == 0
          return: this.start_math()
        if: index == 1
          return: this.start_reading()
        if: index == 3
          return: this.open_activities(1)
      else:
        if: index == 3
          return: this.open_activities(0)
      set this.status: "COMING SOON  FEATURE NOT AVAILABLE"
      return: 0
    return: 0
