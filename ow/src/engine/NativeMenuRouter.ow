# Pure OW menu controller: OW Engine owns the scenes; UI owns input/presentation.
# All six activity adapters are now accessible in the native OW prototype.
class NativeMenuRouter:
  field scenes
  field activity_page
  field status
  field quitting
  field theme_id
  field audio_panel
  field volume
  field last_volume

  fn new(scenes):
    set this.scenes: scenes
    set this.activity_page: 0
    set this.status: ""
    set this.quitting: 0
    set this.theme_id: 0
    set this.audio_panel: 0
    set this.volume: 50
    set this.last_volume: 50

  fn screen():
    return: this.scenes.active_name()

  fn open_menu():
    set this.status: ""
    return: this.scenes.activate("menu")

  fn open_activities(page):
    if: page < 0
      return: 0
    if: page > 1
      return: 0
    if: this.scenes.activate("activities") != 1
      return: 0
    set this.activity_page: page
    set this.status: "ALL SIX ACTIVITIES AVAILABLE"
    return: 1

  fn open_settings():
    if: this.scenes.activate("settings") != 1
      return: 0
    set this.audio_panel: 0
    set this.status: "PROFILE  AUDIO  LANGUAGE  AND DATA RESET"
    return: 1

  fn open_cosmetics():
    if: this.scenes.activate("cosmetics") != 1
      return: 0
    set this.status: "ACTIVE THEME " + this.theme_name()
    return: 1

  fn open_bugreport():
    if: this.scenes.activate("bugreport") != 1
      return: 0
    set this.status: "GITHUB.COM/OW-PROGRAMING-LANGUAGE/CODEWASH-RPG"
    return: 1

  fn open_menu_panel():
    if: this.scenes.activate("menu_panel") != 1
      return: 0
    set this.status: "SIX PLAYABLE OW ACTIVITIES"
    return: 1

  fn theme_name():
    if: this.theme_id == 0
      return: "MINECRAFT"
    if: this.theme_id == 1
      return: "KPOP"
    if: this.theme_id == 2
      return: "POKEMON"
    if: this.theme_id == 3
      return: "SPY"
    if: this.theme_id == 4
      return: "SCIFI"
    return: "FANTASY"

  fn switch_theme(direction):
    if: direction == 1
      set this.theme_id: mod(this.theme_id + 1, 6)
    else:
      if: direction == 0 - 1
        set this.theme_id: mod(this.theme_id + 5, 6)
      else:
        return: 0
    set this.status: "ACTIVE THEME " + this.theme_name()
    return: 1

  fn start_math():
    if: this.scenes.activate("battle") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_reading():
    if: this.scenes.activate("reading") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_writing():
    if: this.scenes.activate("writing") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_cleaning():
    if: this.scenes.activate("cleaning") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_memory():
    if: this.scenes.activate("memory") != 1
      return: 0
    set this.status: ""
    return: 1

  fn start_patterns():
    if: this.scenes.activate("patterns") != 1
      return: 0
    set this.status: ""
    return: 1

  fn back():
    if: this.screen() == "settings"
      if: this.audio_panel == 1
        return: this.open_settings()
    if: this.screen() == "menu"
      set this.quitting: 1
      return: 1
    return: this.open_menu()

  fn focus_card(name):
    if: this.screen() == "menu"
      set this.status: "CARD " + name + "  LEFT RIGHT TO BROWSE"
      return: 1
    if: this.screen() == "activities"
      set this.status: "CARD " + name + "  ENTER TO PLAY"
      return: 1
    return: 0

  fn title():
    if: this.screen() == "battle"
      return: "MATH BATTLE"
    if: this.screen() == "reading"
      return: "READING BATTLE"
    if: this.screen() == "writing"
      return: "WRITING BATTLE"
    if: this.screen() == "cleaning"
      return: "CLEANING TASK"
    if: this.screen() == "memory"
      return: "MEMORY MATCHING"
    if: this.screen() == "patterns"
      return: "PATTERNS RECALL"
    if: this.screen() == "activities"
      if: this.activity_page == 0
        return: "ACTIVITIES  PAGE 1 OF 2"
      return: "ACTIVITIES  PAGE 2 OF 2"
    if: this.screen() == "settings"
      return: "SETTINGS"
    if: this.screen() == "cosmetics"
      return: "THEMES"
    if: this.screen() == "bugreport"
      return: "BUG REPORT"
    if: this.screen() == "menu_panel"
      return: "MENU"
    return: "CODEWASH RPG"

  fn subtitle():
    if: this.screen() == "patterns"
      return: "OBSERVE THEN RECALL THE NEXT COLOR"
    if: this.screen() == "memory"
      return: "FLIP TWO CARDS  MATCH FOUR PAIRS"
    if: this.screen() == "cleaning"
      return: "COMPLETE A REAL CHORE  SELF REPORT"
    if: this.screen() == "writing"
      return: "COPY THE WORD WITH LETTER PAGES"
    if: this.screen() == "reading"
      return: "MATCH THE WORD  FOUR CHOICES"
    if: this.screen() == "settings"
      return: "PROFILES AUDIO LANGUAGE AND SAVE DATA"
    if: this.screen() == "cosmetics"
      return: "CHANGE THE WORLD THEME LIVE"
    if: this.screen() == "bugreport"
      return: "FILE AN ISSUE ON THE PROJECT GITHUB PAGE"
    if: this.screen() == "menu_panel"
      return: "ACTIVITIES AND PROGRESSION TO COME"
    if: this.screen() == "activities"
      return: "SELECT AN ACTIVITY WITH W A S D"
    return: "NATIVE OW ENGINE AND GRAPHICS"

  fn options():
    if: this.screen() == "activities"
      if: this.activity_page == 0
        return: ["MATH", "READING", "WRITING", "NEXT"]
      return: ["CLEANING", "MEMORY", "PATTERNS", "BACK"]
    if: this.screen() == "settings"
      if: this.audio_panel == 1
        return: ["VOLUME DOWN", "VOLUME UP", "MUTE / UNMUTE", "BACK"]
      return: ["MUSIC AND SFX", "LANGUAGE", "RESET DATA", "BACK"]
    if: this.screen() == "cosmetics"
      return: ["NEXT THEME", "PREV THEME", "RESET THEME", "BACK"]
    if: this.screen() == "bugreport"
      return: ["GITHUB ISSUES", "VERSION 1.0", "OFFLINE BUILD", "BACK"]
    if: this.screen() == "menu_panel"
      return: ["ACTIVITIES", "SETTINGS", "THEMES", "BACK"]
    return: ["PLAY MATH", "ACTIVITIES", "SETTINGS", "QUIT"]

  # Returns 1 for a valid routed action, 0 when no action exists, -1
  # for invalid button indices. Never starts an unported skill.
  fn choose(index):
    if: index < 0
      return: 0 - 1
    if: index > 3
      return: 0 - 1
    if: this.screen() == "menu"
      if: index == 0
        return: this.start_math()
      if: index == 1
        return: this.open_activities(0)
      if: index == 2
        return: this.open_settings()
      set this.quitting: 1
      return: 1
    if: this.screen() == "settings"
      if: this.audio_panel == 1
        if: index == 3
          return: this.open_settings()
        if: index == 0
          if: this.volume > 0
            set this.volume: this.volume - 10
        if: index == 1
          if: this.volume < 100
            set this.volume: this.volume + 10
        if: index == 2
          if: this.volume > 0
            set this.last_volume: this.volume
            set this.volume: 0
          else:
            set this.volume: this.last_volume
        set this.status: "MASTER VOLUME " + str(this.volume) + " PERCENT"
        return: 1
      if: index == 0
        set this.audio_panel: 1
        set this.status: "MASTER VOLUME " + str(this.volume) + " PERCENT"
        return: 1
      if: index == 3
        return: this.open_menu()
      set this.status: "COMING SOON  FEATURE NOT AVAILABLE"
      return: 0
    if: this.screen() == "cosmetics"
      if: index == 0
        return: this.switch_theme(1)
      if: index == 1
        return: this.switch_theme(0 - 1)
      if: index == 2
        set this.theme_id: 0
        set this.status: "ACTIVE THEME MINECRAFT"
        return: 1
      return: this.open_menu()
    if: this.screen() == "bugreport"
      if: index == 3
        return: this.open_menu()
      if: index == 0
        set opened int: extension("system.open_url", "https://github.com/OW-Programing-Language/codewash-rpg/issues")
        if: opened == 1
          set this.status: "OPENED GITHUB ISSUES IN YOUR BROWSER"
          return: 1
        set this.status: "COULD NOT OPEN BROWSER  VISIT THE URL ABOVE"
        return: 0
      set this.status: "OPEN GITHUB ISSUES TO SUBMIT"
      return: 0
    if: this.screen() == "menu_panel"
      if: index == 0
        return: this.open_activities(0)
      if: index == 1
        return: this.open_settings()
      if: index == 2
        return: this.open_cosmetics()
      return: this.open_menu()
    if: this.screen() == "activities"
      if: this.activity_page == 0
        if: index == 0
          return: this.start_math()
        if: index == 1
          return: this.start_reading()
        if: index == 2
          return: this.start_writing()
        if: index == 3
          return: this.open_activities(1)
      else:
        if: index == 0
          return: this.start_cleaning()
        if: index == 1
          return: this.start_memory()
        if: index == 2
          return: this.start_patterns()
        if: index == 3
          return: this.open_activities(0)
      set this.status: "COMING SOON  FEATURE NOT AVAILABLE"
      return: 0
    return: 0
