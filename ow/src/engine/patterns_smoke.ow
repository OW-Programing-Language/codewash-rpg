# Phase 2 PR #11: actual Mesa/Xvfb OpenGL Patterns study/recall.
# Sample framebuffer colors, challenge phases and scene preservation.
import "GpuBattle.ow"

main:
  set preview: new GpuBattle()
  call: assert(preview.start() == 1, "native game boots")
  call: assert(preview.menu.open_activities(1) == 1, "open page two")
  call: assert(preview.menu.choose(2) == 1, "Patterns is playable")
  call: assert(preview.menu.screen() == "patterns", "Patterns ECS scene active")
  call: assert(preview.patterns.game.skill.mode() == "choice", "original PatternsSkill")
  call: assert(preview.patterns_activity.phase == 0, "study first")
  call: assert(preview.hud.refresh_patterns(preview.patterns, preview.patterns_activity) == 1, "GPU study HUD")
  call: assert(preview.render() == 4, "Patterns renders four ECS meshes")
  set header: extension("codewash.test.pixel", 24, 447)
  call: assert(header[0] > 150, "visible OpenGL glyphs")
  set selected: extension("codewash.test.pixel", 160, 65)
  set unselected: extension("codewash.test.pixel", 480, 65)
  call: assert(selected[1] > unselected[1] + 30, "highlighted GPU choice")
  set mathHp int: preview.battle.game.mob.cur_hp()
  set hp int: preview.patterns.game.mob.cur_hp()
  set expected: preview.patterns.game.problem.solution()
  call: assert(preview.patterns_activity.choose(1) == 2, "replay does not submit")
  call: assert(preview.patterns.game.mob.cur_hp() == hp, "study never damages")
  call: assert(preview.patterns_activity.choose(0) == 2, "begin recall")
  call: assert(preview.patterns_activity.phase == 1, "recall phase")
  call: assert(preview.patterns_activity.shown_pattern() == "HIDDEN  WHAT COMES NEXT?", "prompt hidden in recall")
  call: assert(preview.patterns_activity.options()[1] == expected, "correct cached choice remains stable")
  call: assert(preview.hud.refresh_patterns(preview.patterns, preview.patterns_activity) == 1, "GPU recall cards")
  call: assert(preview.render() == 4, "recall does not damage")
  call: assert(preview.patterns_activity.choose(0) == 0, "wrong color")
  call: assert(preview.patterns.game.mob.cur_hp() == hp, "wrong color does not hit")
  call: assert(preview.patterns_activity.phase == 0, "wrong answer starts new study")
  call: assert(preview.hud.refresh_patterns(preview.patterns, preview.patterns_activity) == 1, "GPU retry study")
  call: assert(preview.render() == 5, "pink miss GPU feedback")
  set miss: extension("codewash.test.pixel", 225, 370)
  call: assert(miss[0] > miss[1] + 60, "miss effect actual pink pixel")

  call: assert(preview.patterns_activity.choose(0) == 2, "start next recall")
  call: assert(preview.patterns_activity.choose(1) == 1, "correct color")
  call: assert(preview.patterns.game.mob.cur_hp() < hp, "correct color damages monster")
  call: assert(preview.battle.game.mob.cur_hp() == mathHp, "Math independent")
  call: assert(preview.hud.refresh_patterns(preview.patterns, preview.patterns_activity) == 1, "correct HUD")
  call: assert(preview.render() == 5, "gold hit feedback")
  set hit: extension("codewash.test.pixel", 415, 370)
  call: assert(hit[0] > 120, "gold feedback red")
  call: assert(hit[1] > 95, "gold feedback green")
  call: assert(preview.patterns_activity.rounds == 2, "two answered rounds")
  call: assert(preview.patterns_activity.successes == 1, "one success")
  call: assert(preview.patterns_activity.mistakes == 1, "one mistake")
  call: assert(preview.menu.back() == 1, "back to main menu")
  call: assert(preview.hud.refresh_menu(preview.menu) == 1, "menu HUD restored")
  call: assert(preview.render() == 0, "Patterns ECS meshes hidden on menu")
  call: assert(preview.menu.start_patterns() == 1, "resume Patterns")
  call: assert(preview.patterns_activity.rounds == 2, "Patterns progression preserved")
  call: assert(preview.stop() == 1, "GPU released")
  print: "PASS: all-six-activity routing plus native Patterns OpenGL study/recall"
