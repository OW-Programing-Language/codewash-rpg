# Interactive GPU preview only; browser and React/Electron game unchanged.
import "GpuBattle.ow"

main:
  set preview: new GpuBattle()
  call: assert(preview.start() == 1, "OW Engine + OpenGL battle boot")
  print: "CodeWash RPG / experimental GPU math battle"
  print: "Correct=gold hit spark + monster recoil; wrong=pink miss spark + hero recoil"
  call: preview.show_question()
  while: preview.running() == 1
    call: preview.poll()
    if: preview.running() == 1
      set count int: preview.render()
      call: assert(count >= 4, "render four battlefield meshes")
      call: assert(count <= 5, "at most one hit/miss effect")
      call: preview.present()
  call: assert(preview.stop() == 1)
