# Native Cleaning real GPU framebuffer + real CleaningSkill/Game rules.
import "GpuBattle.ow"

main:
  set preview: new GpuBattle()
  call: assert(preview.start() == 1, "native Cleaning preview boots")
  call: assert(preview.menu.open_activities(1) == 1, "second activity page")
  call: assert(preview.menu.choose(0) == 1, "Cleaning playable")
  call: assert(preview.menu.screen() == "cleaning", "Cleaning scene is active")
  call: assert(preview.cleaning.game.skill.mode() == "task", "real CleaningSkill")
  call: assert(preview.hud.refresh_cleaning(preview.cleaning, preview.cleaning_activity) == 1, "task HUD")
  call: assert(preview.render() == 4, "four 3D Cleaning scene objects")
  set hero: extension("codewash.test.pixel", 450, 360)
  call: assert(hero[2] > hero[0] + 30, "cyan hero visible")
  set glyph: extension("codewash.test.pixel", 48, 671)
  call: assert(glyph[0] > 150, "task level text visible")
  set selected: extension("codewash.test.pixel", 320, 98)
  set ordinary: extension("codewash.test.pixel", 960, 98)
  call: assert(selected[1] > ordinary[1] + 30, "task option highlighted")

  set before int: preview.cleaning.game.mob.cur_hp()
  set mathBefore int: preview.battle.game.mob.cur_hp()
  call: assert(preview.cleaning_activity.choose(3) == 2, "help admits self-reporting")
  call: assert(preview.cleaning_activity.choose(0) == 2, "START only")
  call: assert(preview.cleaning.game.mob.cur_hp() == before, "no start-only credit")
  call: assert(preview.hud.refresh_cleaning(preview.cleaning, preview.cleaning_activity) == 1, "started task HUD")
  call: assert(preview.cleaning_activity.choose(0) == 1, "Mark Done records task")
  call: assert(preview.cleaning_activity.completed == 1, "exactly one reported completion")
  call: assert(preview.cleaning.game.mob.cur_hp() < before, "completion damages container")
  call: assert(preview.battle.game.mob.cur_hp() == mathBefore, "Math state preserved")
  call: assert(preview.hud.refresh_cleaning(preview.cleaning, preview.cleaning_activity) == 1, "new task HUD")
  call: assert(preview.render() == 5, "gold task feedback in 3D")
  set hit: extension("codewash.test.pixel", 830, 555)
  call: assert(hit[0] > 120, "gold completion feedback red")
  call: assert(hit[1] > 95, "gold completion feedback green")
  set hp int: preview.cleaning.game.mob.cur_hp()
  call: assert(preview.cleaning_activity.choose(0) == 2, "next press starts new task")
  call: assert(preview.cleaning.game.mob.cur_hp() == hp, "no double award")
  call: assert(preview.cleaning_activity.choose(1) == 0, "cancel avoids credit")
  call: assert(preview.cleaning.game.mob.cur_hp() == hp, "cancel no damage")
  call: assert(preview.menu.back() == 1, "return to menu")
  call: assert(preview.hud.refresh_menu(preview.menu) == 1, "menu HUD")
  call: assert(preview.render() == 0, "inactive Cleaning meshes hidden")
  call: assert(preview.menu.start_cleaning() == 1, "resume Cleaning")
  call: assert(preview.cleaning_activity.completed == 1, "completion count persists")
  call: assert(preview.stop() == 1, "GPU cleaned up")
  print: "PASS: native Cleaning task completion gating and Mesa framebuffer"
