# Native Mesa/GPU proof that the original Electron toolbar roles survive.
# Settings, theme browsing and report panels are native, not fake W/A/S/D.
import "GpuBattle.ow"

main:
  set game: new GpuBattle()
  call: assert(game.start() == 1, "native OW menu starts")
  call: assert(game.hud.toolbar_icons > 0, "real vector toolbar icons uploaded")
  call: assert(game.hud.toolbar_art.program > 0, "rounded anti-aliased icon shader created")
  call: assert(game.hud.modal_panel > 0, "drawer GPU surface uploaded")
  call: assert(game.render() == 0, "five-card menu renders")
  set sparkle: extension("codewash.test.pixel", 126, 669)
  call: assert(sparkle[2] > sparkle[1], "native Themes sparkle contains colored icon, not an empty button")
  set menu_ink: extension("codewash.test.pixel", 1216, 669)
  call: assert(menu_ink[0] > 160, "native top-right Menu has visible white horizontal bars")
  set bug: extension("codewash.test.pixel", 1223, 64)
  call: assert(bug[0] > bug[1] + 45, "bug report icon is visible above the bottom edge")
  call: assert(game.pointer.hit(0.0 - 0.91, 0.85, "menu", game.carousel, game.layout) == 10, "gear hitbox")
  call: assert(game.pointer.hit(0.0 - 0.77, 0.85, "menu", game.carousel, game.layout) == 11, "theme sparkle hitbox")
  call: assert(game.pointer.hit(0.91, 0.85, "menu", game.carousel, game.layout) == 13, "menu drawer hitbox")
  call: assert(game.pointer.hit(0.91, 0.0 - 0.87, "menu", game.carousel, game.layout) == 14, "bug report hitbox")
  call: assert(game.toolbar_action(0) == 1, "click gear opens settings")
  call: assert(game.menu.screen() == "settings", "settings scene activated")
  call: assert(game.hud.menu_show_cards == 0, "cards hidden under settings panel")
  call: assert(game.render() == 0, "settings panel renders on Mesa")
  call: assert(game.toolbar_action(1) == 1, "click sparkle opens cosmetics")
  call: assert(game.menu.screen() == "cosmetics", "cosmetics scene activated")
  call: assert(game.menu.choose(0) == 1, "next theme")
  call: assert(game.art.select_theme(game.menu.theme_id) == 1, "theme PNG/JPEG loaded into OpenGL")
  call: assert(game.art.theme_id == 1, "KPOP selected")
  call: assert(game.render() == 0, "original alternative theme rendered")
  call: assert(game.menu.choose(1) == 1, "previous theme")
  call: assert(game.art.select_theme(game.menu.theme_id) == 1, "restore Minecraft GPU texture")
  call: assert(game.art.theme_id == 0, "Minecraft selected")
  call: assert(game.toolbar_action(4) == 1, "bug icon opens bug report")
  call: assert(game.menu.screen() == "bugreport", "bug report panel accessible")
  call: assert(game.render() == 0, "bug report panel rendered")
  call: assert(game.toolbar_action(3) == 1, "menu button opens menu drawer")
  call: assert(game.menu.screen() == "menu_panel", "menu drawer accessible")
  call: assert(game.menu.choose(3) == 1, "back returns to main menu")
  call: assert(game.hud.refresh_menu(game.menu) == 1, "card focus restored")
  call: assert(game.render() == 0, "main menu restored")
  call: assert(game.stop() == 1, "GPU resources cleanly released")
  call: assert(game.hud.toolbar_icons == 0, "toolbar GPU mesh freed")
  call: assert(game.hud.toolbar_art.program == 0, "icon shader released")
  call: assert(game.hud.modal_panel == 0, "drawer mesh freed")
  print: "PASS: native settings, cosmetics, bug and menu toolbar icons with themed GPU"
