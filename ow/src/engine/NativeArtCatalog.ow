# Paths relative to the ow/ working directory used by the launcher and CI.
# Reuse existing repository PNG artwork; no downloaded or generated placeholders.
# OW Graphics' pinned ImageIO path decodes PNG/JPEG, not animated GIF/WebP.
class NativeArtCatalog:
  fn icon_slot(skill):
    if: skill == "math"
      return: 0
    if: skill == "reading"
      return: 1
    if: skill == "writing"
      return: 2
    if: skill == "cleaning"
      return: 3
    if: skill == "memory"
      return: 4
    if: skill == "patterns"
      return: 5
    return: 0 - 1

  fn icon_path(index):
    if: index == 0
      return: "../public/assets/skills/math_icon.png"
    if: index == 1
      return: "../public/assets/items/map.png"
    if: index == 2
      return: "../public/assets/skills/writing_icon.png"
    if: index == 3
      return: "../public/assets/skills/farm_icon.png"
    if: index == 4
      return: "../public/assets/badges/wood_badge.png"
    if: index == 5
      return: "../public/assets/skills/pattern_icon.png"
    return: ""

  # Resolve only verified original PNGs. If a mob only ships as GIF/WebP
  # use the neutral egg emblem; never display a different named mob.
  fn mob_path(label):
    if: label == "Creeper"
      return: "../public/assets/mobs/hostile/creeper.png"
    if: label == "Zombie"
      return: "../public/assets/mobs/hostile/zombie.png"
    if: label == "Bogged"
      return: "../public/assets/mobs/hostile/bogged.png"
    if: label == "Drowned"
      return: "../public/assets/mobs/hostile/drowned.png"
    if: label == "Enderman"
      return: "../public/assets/mobs/hostile/enderman.png"
    if: label == "Evoker"
      return: "../public/assets/mobs/hostile/evoker.png"
    if: label == "Hoglin"
      return: "../public/assets/mobs/hostile/hoglin.png"
    if: label == "Magma Cube"
      return: "../public/assets/mobs/hostile/magmacube.png"
    if: label == "Parched"
      return: "../public/assets/mobs/hostile/parched.png"
    if: label == "Piglin"
      return: "../public/assets/mobs/hostile/piglin.png"
    if: label == "Pillager"
      return: "../public/assets/mobs/hostile/pillager.png"
    if: label == "Skeleton"
      return: "../public/assets/mobs/hostile/skeleton.png"
    if: label == "Slime"
      return: "../public/assets/mobs/hostile/slime.png"
    if: label == "Spider"
      return: "../public/assets/mobs/hostile/spider.png"
    if: label == "Witch"
      return: "../public/assets/mobs/hostile/witch.png"
    if: label == "Creaking"
      return: "../public/assets/mobs/miniboss/creaking.png"
    if: label == "Ravager"
      return: "../public/assets/mobs/miniboss/ravager.png"
    if: label == "Wither Skeleton"
      return: "../public/assets/mobs/miniboss/witherskeleton.png"
    if: label == "Herobrine"
      return: "../public/assets/mobs/boss/Herobrine.png"
    if: label == "Wither"
      return: "../public/assets/mobs/boss/wither.png"
    return: "../public/assets/items/egg.png"
