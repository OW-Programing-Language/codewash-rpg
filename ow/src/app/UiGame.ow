# Application composition root for the Code Wash RPG slice.
#
# This file lives OUTSIDE any api/ or infra/ zone, so (per the compiler's module
# boundary rules) it is the only place allowed to import modules' infra/ — which
# is exactly a Spring-Modulith composition root. It wires every module with a
# flOW functor (app.apply(...)) and then talks to the game purely through flOW
# services: it holds no domain logic itself.
import "@flow/src/App.ow"
import "../modules/sound/infra/SoundFunctor.ow"
import "../modules/achievements/infra/AchievementsFunctor.ow"
import "../modules/theme/infra/ThemeFunctor.ow"
import "../modules/stats/infra/StatsFunctor.ow"
import "../modules/save/infra/SaveFunctor.ow"
import "../modules/bugreport/infra/BugReportFunctor.ow"
import "../modules/i18n/infra/TranslationFunctor.ow"
import "../modules/progression/infra/ProgressionFunctor.ow"
import "../modules/mob/infra/MobFunctor.ow"
import "../modules/skills/infra/SkillsFunctor.ow"
import "../modules/combat/infra/CombatFunctor.ow"

class UiGame:
  field game
  field screen
  field bg
  field logo
  field theme
  field app

  fn new():
    set this.screen: "menu"
    # flOW application context. Every concern is a module built by a functor;
    # configuration is injected through flOW config before boot.
    set this.app: new App()
    call: this.app.set_config("sound.track", "calm1")
    call: this.app.set_config("save.interval", 5)
    call: this.app.set_config("i18n.lang", "en")
    call: this.app.apply(new ProgressionFunctor())
    call: this.app.apply(new MobFunctor())
    call: this.app.apply(new SkillsFunctor())
    call: this.app.apply(new CombatFunctor())
    call: this.app.apply(new SoundFunctor())
    call: this.app.apply(new AchievementsFunctor())
    call: this.app.apply(new ThemeFunctor())
    call: this.app.apply(new StatsFunctor())
    call: this.app.apply(new SaveFunctor())
    call: this.app.apply(new BugReportFunctor())
    call: this.app.apply(new TranslationFunctor())
    call: this.app.boot()
    # Talk to the game and the theme through their services.
    set this.game: this.app.service("game")
    call: this.sync_theme()

  # ---- service helpers ----
  fn sync_theme():
    set t: this.app.service("theme")
    set this.theme: t.current()
    set this.bg: t.bg()
    set this.logo: t.logo()
    return: 0

  fn theme_name():
    return: this.app.service("theme").label()

  fn t(key):
    return: this.app.service("i18n").t(key)

  fn ach_count():
    return: this.app.service("achievements").total()

  # Switch the active theme via the bus; re-read the backdrop/logo.
  fn set_theme(id):
    call: this.app.emit("theme.change", id)
    call: this.sync_theme()

  # Toggle sound by enabling/disabling the flOW sound module.
  fn set_sound(v):
    if: v == 0
      call: this.app.disable("sound")
    else:
      call: this.app.enable("sound")
    return: 0

  # Feedback after an action: emit domain events; Sound/Achievements/Stats/Save
  # all react independently.
  fn feedback(before):
    set now int: this.game.hero.lvl()
    call: this.app.emit("turn", 0)
    if: now > before
      call: this.app.emit("hero.levelup", now)

  # ---- UI event handlers ----
  fn launch(s):
    call: this.game.use_skill(s)
    call: this.game.start(1)
    set this.screen: "battle"
    call: this.app.emit("music.start", 0)

  # Skills are built by the skills module's factory service.
  fn begin(id):
    call: this.launch(this.app.service("skills").make(id))

  fn begin_math():
    call: this.begin("math")

  fn begin_reading():
    call: this.begin("reading")

  fn begin_writing():
    call: this.begin("writing")

  fn begin_memory():
    call: this.begin("memory")

  fn begin_patterns():
    call: this.begin("patterns")

  fn begin_cleaning():
    call: this.begin("cleaning")

  # Cleaning: finishing a task clears the mess (a hit) and brings the next task.
  fn complete():
    set before int: this.game.hero.lvl()
    call: this.game.hit()
    call: this.game.next_problem()
    call: this.feedback(before)

  # Returning to the menu is a natural save point: the SaveModule flushes.
  fn to_menu():
    set this.screen: "menu"
    call: this.app.emit("game.save", 0)

  fn pick(n):
    set before int: this.game.hero.lvl()
    call: this.game.answer(n)
    call: this.feedback(before)

  # Typed answer (Writing): normalise case/whitespace before comparing.
  fn pick_text(v):
    set before int: this.game.hero.lvl()
    call: this.game.answer(upper(trim(v)))
    call: this.feedback(before)

  # Memory: flip a card; a matched pair lands a hit, a cleared board deals a new one.
  fn flip_card(i):
    set before int: this.game.hero.lvl()
    set res: this.game.skill.flip(i)
    if: res == "match"
      call: this.game.hit()
    if: this.game.skill.is_cleared() == 1
      call: this.game.skill.start_board()
    if: res == "match"
      call: this.feedback(before)

  fn opts():
    return: this.game.skill.options(this.game.problem)

  # XP progress toward the next level, read from the progression service.
  fn xp_bar():
    set g: this.game
    set pr: this.app.service("progression")
    return: ui_bar(g.hero.xp_v(), pr.xp_to_level(g.hero.diff()), "yellow")

  # The foe's name and sprite, read from the mob (bestiary) service.
  fn foe_label():
    if: this.game.skill.mode() == "task"
      return: this.game.skill.chest_name()
    return: this.game.mob.label()

  fn foe_sprite_path():
    set m: this.app.service("mob")
    if: this.game.skill.mode() == "task"
      return: m.chest_for(this.game.skill.chest_name())
    return: m.sprite_for(this.game.mob.label())

  # ---- screens ----
  fn menu_view():
    set logo: ui_image(this.logo, 420, 160)
    set title: ui_heading("CODE WASH RPG")
    set sub: ui_text(this.t("tagline"), "yellow")
    set play_math: ui_button("Math shift", "app.begin_math")
    set play_read: ui_button("Reading shift", "app.begin_reading")
    set play_write: ui_button("Writing shift", "app.begin_writing")
    set play_mem: ui_button("Memory shift", "app.begin_memory")
    set play_pat: ui_button("Patterns shift", "app.begin_patterns")
    set play_clean: ui_button("Cleaning shift", "app.begin_cleaning")
    set row1: ui_row([play_math, play_read])
    set row2: ui_row([play_write, play_mem])
    set row3: ui_row([play_pat, play_clean])
    set tlabel: ui_text(this.t("theme") + ": " + this.theme_name(), "yellow")
    set tb_mc: ui_button("Minecraft", "app.set_theme", "minecraft")
    set tb_kp: ui_button("K-Pop", "app.set_theme", "kpop")
    set tb_pk: ui_button("Pokemon", "app.set_theme", "pokemon")
    set tb_sp: ui_button("Spy", "app.set_theme", "spy")
    set tb_sf: ui_button("Sci-Fi", "app.set_theme", "scifi")
    set tb_ft: ui_button("Fantasy", "app.set_theme", "fantasy")
    set trow1: ui_row([tb_mc, tb_kp, tb_pk])
    set trow2: ui_row([tb_sp, tb_sf, tb_ft])
    set items: [logo, title, sub, ui_space(8), row1, row2, row3, ui_space(8), tlabel, trow1, trow2]
    return: ui_backdrop(this.bg, ui_card(items))

  fn answers_widget():
    if: this.game.skill.mode() == "text"
      return: ui_input("", "app.pick_text")
    if: this.game.skill.mode() == "task"
      return: ui_button("Complete!", "app.complete")
    set o: this.opts()
    set b0: ui_button(str(o[0]), "app.pick", o[0])
    set b1: ui_button(str(o[1]), "app.pick", o[1])
    set b2: ui_button(str(o[2]), "app.pick", o[2])
    set b3: ui_button(str(o[3]), "app.pick", o[3])
    return: ui_row([b0, b1, b2, b3])

  fn battle_view():
    set g: this.game
    set name: ui_heading(this.foe_label(), "red")
    set sprite: ui_image(this.foe_sprite_path(), 160, 160)
    set hp: ui_bar(g.mob.cur_hp(), g.mob.max_hp(), "red")
    set q: ui_heading(g.problem.ask())
    set row: this.answers_widget()
    set msg: ui_text(g.message, "yellow")
    set hud: ui_text("Level " + g.hero.lvl() + "     Diff " + g.hero.diff() + "     Achievements " + this.ach_count())
    set xp: this.xp_bar()
    set back: ui_button(this.t("back"), "app.to_menu")
    set items: [name, sprite, hp, ui_space(6), q, ui_space(8), row, ui_space(8), msg, hud, xp, ui_space(6), back]
    return: ui_backdrop(this.bg, ui_card(items))

  fn memory_view():
    set g: this.game
    set s: g.skill
    set name: ui_heading(g.mob.label(), "red")
    set sprite: ui_image(this.app.service("mob").sprite_for(g.mob.label()), 120, 120)
    set hp: ui_bar(g.mob.cur_hp(), g.mob.max_hp(), "red")
    set instr: ui_heading("Match the pairs!")
    set c0: ui_button(s.face(0), "app.flip_card", 0)
    set c1: ui_button(s.face(1), "app.flip_card", 1)
    set c2: ui_button(s.face(2), "app.flip_card", 2)
    set c3: ui_button(s.face(3), "app.flip_card", 3)
    set c4: ui_button(s.face(4), "app.flip_card", 4)
    set c5: ui_button(s.face(5), "app.flip_card", 5)
    set c6: ui_button(s.face(6), "app.flip_card", 6)
    set c7: ui_button(s.face(7), "app.flip_card", 7)
    set grid: ui_grid(4, [c0, c1, c2, c3, c4, c5, c6, c7])
    set msg: ui_text(g.message, "yellow")
    set hud: ui_text("Level " + g.hero.lvl() + "     Diff " + g.hero.diff() + "     Achievements " + this.ach_count())
    set xp: this.xp_bar()
    set back: ui_button(this.t("back"), "app.to_menu")
    set items: [name, sprite, hp, ui_space(6), instr, grid, ui_space(8), msg, hud, xp, ui_space(6), back]
    return: ui_backdrop(this.bg, ui_card(items))

  fn render():
    if: this.screen == "menu"
      return: this.menu_view()
    if: this.game.skill.mode() == "memory"
      return: this.memory_view()
    return: this.battle_view()
