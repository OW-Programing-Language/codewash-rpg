# The bestiary, ported from HOSTILE_MOBS / MINIBOSS_MOBS / BOSS_MOBS
# in src/constants/gameData.jsx. Names only: the OW console port has
# no sprites (see docs/PORTING.md). The original Minecraft-themed
# names are kept verbatim for a faithful port; re-theming them is
# tracked as debt in docs/PORTING.md.
class MobPool:
  field hostile
  field mini
  field boss

  fn new():
    # Array literals (new OW style) replace the old array(n)+index-fill blocks.
    set this.hostile: ["Blaze", "Bogged", "Breeze", "Creeper", "Drowned", "Enderman", "Evoker", "Ghast", "Guardian", "Hoglin", "Magma Cube", "Parched", "Phantom", "Piglin", "Pillager", "Skeleton", "Slime", "Spider", "Witch", "Zombie"]
    set this.mini: ["Creaking", "Elder Guardian", "Ravager", "Wither Skeleton"]
    set this.boss: ["Ender Dragon", "Herobrine", "Warden", "Wither"]

  # code: 2 = boss, 1 = miniboss, 0 = hostile. len() keeps the pick in range as
  # the pools grow, instead of hard-coded counts.
  fn pick(code):
    switch: code
      case 2:
        return: this.boss[rand(len(this.boss))]
      case 1:
        return: this.mini[rand(len(this.mini))]
      default:
        return: this.hostile[rand(len(this.hostile))]
