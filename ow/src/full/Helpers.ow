# Collection helpers; all game decisions run in the OW interpreter.
fn append(xs, value):
  set out: array(len(xs) + 1, 0)
  set i: 0
  while: i < len(xs)
    set out[i]: xs[i]
    set i: i + 1
  set out[i]: value
  return: out

fn has(xs, value):
  set i: 0
  while: i < len(xs)
    if: xs[i] == value
      return: 1
    set i: i + 1
  return: 0

fn unique(xs, value):
  if: has(xs, value)
    return: xs
  return: append(xs, value)

fn shuffled(xs):
  set out: json_parse(json(xs))
  set i: len(out) - 1
  while: i > 0
    set j: rand(i + 1)
    set tmp: out[i]
    set out[i]: out[j]
    set out[j]: tmp
    set i: i - 1
  return: out

fn pick(xs):
  return: xs[rand(len(xs))]

fn escape_html(value):
  set s: replace(str(value), "&", "&amp;")
  set s: replace(s, "<", "&lt;")
  set s: replace(s, ">", "&gt;")
  set s: replace(s, "\"", "&quot;")
  return: replace(s, "'", "&#39;")

fn asset(path):
  return: "/media/asset?path=../public/" + replace(path, " ", "%20")

fn picture(path, alt, css):
  return: "<img class='" + escape_html(css) + "' src='" + escape_html(asset(path)) + "' alt='" + escape_html(alt) + "' draggable='false'>"

fn button(label, action, value, css):
  return: "<button class='" + escape_html(css) + "' data-action='" + escape_html(action) + "' data-value='" + escape_html(value) + "'>" + label + "</button>"

fn normalized(s):
  return: replace(upper(trim(s)), " ", "")

fn repeat_power(base, exponent):
  set value: 1.0
  set i: 0
  while: i < exponent
    set value: value * base
    set i: i + 1
  return: value
