# A flOW module that tracks achievements purely by listening to game events.
# It has no reference to the game, the skills or the UI — it only reacts to what
# is published on the bus, which is exactly how a new cross-cutting feature plugs
# into a modular monolith.
#
# Events it listens to:
#   "turn"         -> one action was taken (count toward effort achievements)
#   "hero.levelup" -> payload is the new level (level milestones)
import "@flow/src/Module.ow"

class AchievementsModule(Module):
  field turns
  field unlocked
  field a_first
  field a_ten
  field a_25
  field a_lvl2
  field a_lvl5

  fn new():
    set this.turns: 0
    set this.unlocked: 0
    set this.a_first: 0
    set this.a_ten: 0
    set this.a_25: 0
    set this.a_lvl2: 0
    set this.a_lvl5: 0

  # ---- flOW Module contract ----
  fn name():
    return: "achievements"

  fn requires():
    return: array(0, 0)

  fn register(app):
    call: app.provide("achievements", this)
    return: 0

  fn start(app):
    return: 0

  # flOW now performs ordered shutdown/rollback; nothing to tear down here.
  fn stop(app):
    return: 0

  # Reset all progress (e.g. when switching profiles).
  fn reload(app):
    set this.turns: 0
    set this.unlocked: 0
    set this.a_first: 0
    set this.a_ten: 0
    set this.a_25: 0
    set this.a_lvl2: 0
    set this.a_lvl5: 0
    return: 0

  fn total():
    return: this.unlocked

  fn unlock(label):
    set this.unlocked: this.unlocked + 1
    print: "[achievement] Unlocked: " + label
    return: 0

  # ---- flOW Listener contract ----
  fn on_event(type, payload):
    if: type == "turn"
      set this.turns: this.turns + 1
      if: this.turns == 1
        if: this.a_first == 0
          set this.a_first: 1
          call: this.unlock("First Clean")
      if: this.turns == 10
        if: this.a_ten == 0
          set this.a_ten: 1
          call: this.unlock("Hard Worker (10 actions)")
      if: this.turns == 25
        if: this.a_25 == 0
          set this.a_25: 1
          call: this.unlock("Washing Machine (25 actions)")
    if: type == "hero.levelup"
      if: payload > 1
        if: this.a_lvl2 == 0
          set this.a_lvl2: 1
          call: this.unlock("Level 2 reached")
      if: payload > 4
        if: this.a_lvl5 == 0
          set this.a_lvl5: 1
          call: this.unlock("Level 5 reached")
    return: 0
