# Implementation of the autosave-policy concern (infra zone). The interval is
# injected by SaveFunctor from flOW config "save.interval".
#
# Events it handles:
#   "turn"      -> count an action; mark a save pending at the interval
#   "game.save" -> flush: record a save and reset the counter
import "@flow/src/Module.ow"
import "../api/SaveApi.ow"

class SaveModule(Module, SaveApi):
  field since
  field saves
  field pending
  field interval

  fn new():
    set this.since: 0
    set this.saves: 0
    set this.pending: 0
    set this.interval: 5

  # ---- flOW Module contract ----
  fn name():
    return: "save"

  fn requires():
    return: array(0, 0)

  fn register(app):
    call: app.provide("save", this)
    return: 0

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    set this.since: 0
    set this.pending: 0
    return: 0

  fn on_event(type, payload):
    if: type == "turn"
      set this.since: this.since + 1
      if: this.since > (this.interval - 1)
        set this.pending: 1
    if: type == "game.save"
      call: this.flush()
    return: 0

  # ---- configuration (injected by the functor) ----
  fn set_interval(n):
    set this.interval: n
    return: 0

  fn flush():
    set this.saves: this.saves + 1
    set this.since: 0
    set this.pending: 0
    return: 0

  # ---- SaveApi ----
  fn pending_save():
    return: this.pending

  fn save_count():
    return: this.saves

  fn turns_since_save():
    return: this.since
