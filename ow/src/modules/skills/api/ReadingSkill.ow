import "Problem.ow"

# Reading skill, ported from getReadingWord() + READING_WORDS / FUNNY_LONG_WORDS
# in src/utils/gameUtils.js and src/constants/gameData.jsx.
#
# As a button-answerable mini-game (the React version uses the microphone), the
# challenge shows a target word and four word buttons; the player taps the word
# that matches. Difficulty maps to word length: 1->3 letters ... 6->8, 7->long.
class ReadingSkill:
  field pools
  field curpool

  fn new():
    set ps: array(8, 0)
    set ps[1]: ["CAT", "DOG", "SUN", "BAT", "HAT", "RUN", "BIG", "RED", "FOX", "MOM", "DAD", "CUP", "BUS", "PEN", "ANT", "BEE"]
    set ps[2]: ["BOOK", "TREE", "FISH", "BALL", "CAKE", "BIRD", "FROG", "PLAY", "JUMP", "MILK", "DOOR", "DUCK", "STAR", "MOON", "RAIN"]
    set ps[3]: ["APPLE", "HOUSE", "WATER", "HAPPY", "MUSIC", "TIGER", "BEACH", "PLANT", "CLOUD", "SMILE", "PIZZA", "GRAPE", "HORSE", "SHEEP"]
    set ps[4]: ["BANANA", "ORANGE", "PURPLE", "GARDEN", "FRIEND", "SCHOOL", "FLOWER", "RABBIT", "MONKEY", "BUTTON", "CASTLE", "DRAGON", "FOREST"]
    set ps[5]: ["DIAMOND", "EMERALD", "CHICKEN", "RAINBOW", "DOLPHIN", "PENGUIN", "GIRAFFE", "PUMPKIN", "VOLCANO", "TORNADO", "MONSTER", "TEACHER"]
    set ps[6]: ["SKELETON", "ELEPHANT", "TREASURE", "CROCODILE", "FIREWORK", "BIRTHDAY", "SANDWICH", "DINOSAUR", "COMPUTER", "MUSHROOM"]
    set ps[7]: ["ANTIDISESTABLISHMENTARIANISM", "SUPERCALIFRAGILISTICEXPIALIDOCIOUS", "FLOCCINAUCINIHILIPILIFICATION", "PSEUDOPSEUDOHYPOPARATHYROIDISM", "INCOMPREHENSIBILITIES", "HONORIFICABILITUDINITY"]
    set this.pools: ps
    set this.curpool: ps[1]

  fn mode():
    return: "choice"

  # Select the word pool for difficulty d (1-7) and return a target word.
  fn generate(d):
    set idx int: d
    if: idx < 1
      set idx: 1
    if: idx > 7
      set idx: 7
    set this.curpool: this.pools[idx]
    set word: this.rand_word()
    set p: new Problem()
    call: p.init(word, word)
    return: p

  fn rand_word():
    set n int: len(this.curpool)
    return: this.curpool[rand(n)]

  # Pick a word from the current pool that differs from x, y and z.
  fn pick_not(x, y, z):
    set cand: this.rand_word()
    set tries int: 0
    while: tries < 40
      if: cand != x
        if: cand != y
          if: cand != z
            set tries: 999
      if: tries < 100
        set cand: this.rand_word()
        set tries: tries + 1
    return: cand

  # Four word choices including the correct one (at index 1).
  fn options(p):
    set w: p.solution()
    set a: this.pick_not(w, w, w)
    set b: this.pick_not(w, a, a)
    set c: this.pick_not(w, a, b)
    return: [a, w, b, c]
