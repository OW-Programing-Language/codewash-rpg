# A flOW module that owns the active theme. The UI no longer carries theme
# logic: it emits "theme.change" (payload = theme id) and reads the current
# backdrop / logo / display name back from the "theme" service this provides.
#
# Events it handles:
#   "theme.change" -> switch the active theme (payload is the theme id string)
import "@flow/src/Module.ow"
import "../../ThemeBank.ow"

class ThemeModule(Module):
  field bank
  field cur

  fn new():
    set this.bank: new ThemeBank()
    set this.cur: "minecraft"

  # ---- flOW Module contract ----
  fn name():
    return: "theme"

  fn requires():
    return: array(0, 0)

  fn register(app):
    call: app.provide("theme", this)
    return: 0

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  # Reset to the default theme (e.g. on a new profile).
  fn reload(app):
    set this.cur: "minecraft"
    return: 0

  fn on_event(type, payload):
    if: type == "theme.change"
      call: this.change(payload)
    return: 0

  # ---- service API (read by the UI) ----
  fn change(id):
    set this.cur: id
    return: 0

  fn current():
    return: this.cur

  fn label():
    return: this.bank.name(this.cur)

  fn bg():
    return: this.bank.bg(this.cur)

  fn logo():
    return: this.bank.logo(this.cur)
