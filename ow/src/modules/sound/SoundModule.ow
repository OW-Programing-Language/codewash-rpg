# A flOW module that owns all audio. The App delivers events to it (while it is
# enabled), so the rest of the game never calls the audio builtins directly —
# gameplay and sound stay decoupled.
#
# Config:
#   "sound.track" -> background music file stem (default "calm1")
# Events it handles:
#   "music.start"  -> begin looping background music (once)
#   "turn"         -> a short click on each action
#   "hero.levelup" -> a jingle when the hero levels up
import "@flow/src/Module.ow"

class SoundModule(Module):
  field snd
  field music_on
  field app

  fn new():
    set this.snd: 1
    set this.music_on: 0

  # ---- flOW Module contract ----
  fn name():
    return: "sound"

  fn requires():
    return: array(0, 0)

  fn register(app):
    set this.app: app
    call: app.provide("sound", this)
    return: 0

  fn start(app):
    return: 0

  # flOW now performs ordered shutdown/rollback; nothing to tear down here.
  fn stop(app):
    return: 0

  fn on_event(type, payload):
    if: type == "music.start"
      call: this.start_music()
    if: type == "turn"
      call: this.sfx("click.wav")
    if: type == "hero.levelup"
      call: this.sfx("levelup.wav")
    return: 0

  # Reset so music can start again (e.g. after a theme/config change).
  fn reload(app):
    set this.music_on: 0
    return: 0

  # ---- audio (native backend plays the original .wav assets) ----
  fn set_sound(v):
    set this.snd: v

  fn start_music():
    if: this.music_on == 1
      return: 0
    set this.music_on: 1
    set track: this.app.config_or("sound.track", "calm1")
    call: audio_music("../public/assets/sounds/bgm/" + track + ".wav")

  # Kept last so a missing/unsupported file never aborts the caller.
  fn sfx(file):
    if: this.snd == 0
      return: 0
    call: audio_play("../public/assets/sounds/ui/ui/" + file)
