# Implementation of the bug-report concern (infra zone) — the OW port of the
# React app's bug reporting, fully decoupled from where errors occur.
#
# Events it handles:
#   "error" -> payload is a message string; buffer it for a diagnostic report
import "@flow/src/Module.ow"
import "../api/BugReportApi.ow"

class BugReportModule(Module, BugReportApi):
  field count
  field last

  fn new():
    set this.count: 0
    set this.last: ""

  # ---- flOW Module contract ----
  fn name():
    return: "bugreport"

  fn requires():
    return: array(0, 0)

  fn register(app):
    call: app.provide("bugreport", this)
    return: 0

  fn start(app):
    return: 0

  fn stop(app):
    return: 0

  fn reload(app):
    set this.count: 0
    set this.last: ""
    return: 0

  fn on_event(type, payload):
    if: type == "error"
      call: this.record(payload)
    return: 0

  fn record(message):
    set this.count: this.count + 1
    set this.last: message
    return: 0

  # ---- BugReportApi ----
  fn total():
    return: this.count

  fn last_message():
    return: this.last

  fn report():
    return: {errors: this.count, last: this.last}
