# flOW — the application context's service/config store.
# A small name -> value map (Ow has no dynamic-key maps, so this is a
# fixed-capacity pair of arrays with a linear scan).
#
# Note: local variables are prefixed `fl_` on purpose. Ow leaks a method's
# locals into the caller's scope when names collide, so framework code uses
# distinctive names to never clobber a user's variables.
class Registry:
  field keys
  field vals
  field count

  fn new():
    set this.keys: array(64, "")
    set this.vals: array(64, 0)
    set this.count: 0

  fn has(name):
    set fl_i int: 0
    set fl_found int: 0
    while: fl_i < this.count
      if: this.keys[fl_i] == name
        set fl_found: 1
      set fl_i: fl_i + 1
    return: fl_found

  fn put(name, val):
    set fl_ks: this.keys
    set fl_vs: this.vals
    set fl_i int: 0
    set fl_done int: 0
    while: fl_i < this.count
      if: fl_ks[fl_i] == name
        set fl_vs[fl_i]: val
        set fl_done: 1
      set fl_i: fl_i + 1
    if: fl_done == 0
      set fl_ks[this.count]: name
      set fl_vs[this.count]: val
      set this.count: this.count + 1
    return: 0

  fn get(name):
    set fl_i int: 0
    set fl_out: 0
    while: fl_i < this.count
      if: this.keys[fl_i] == name
        set fl_out: this.vals[fl_i]
      set fl_i: fl_i + 1
    return: fl_out
