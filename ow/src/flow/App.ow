import "Registry.ow"

# flOW — the application context.
#
# Holds the registered modules, a service registry, a config store and the event
# dispatch. Modules are first-class and manageable at runtime:
#   - parameterizable: read settings via app.config_or("module.key", default)
#   - enable / disable: a disabled module receives no events
#   - reload: re-initialise a single module (reset its state)
#   - functors: app.apply(functor) builds a configured module (OCaml-style)
#
# Events are delivered to every ENABLED module's on_event(type, payload), so a
# module never references the others — it just reacts to what is published.
#
# Boot lifecycle: register (wire) -> verify (deps) -> start (run).
#
# Note: local variables are prefixed `fl_` on purpose. Ow leaks a method's
# locals into the caller's scope on a name collision, so framework code uses
# distinctive names to never clobber a user's loop variables (e.g. `i`).
class App:
  field registry
  field config
  field mods
  field names
  field enabled
  field count

  fn new():
    set this.registry: new Registry()
    set this.config: new Registry()
    set this.mods: array(64, 0)
    set this.names: array(64, "")
    set this.enabled: array(64, 1)
    set this.count: 0

  fn use(m):
    set fl_ms: this.mods
    set fl_ns: this.names
    set fl_es: this.enabled
    set fl_ms[this.count]: m
    set fl_ns[this.count]: m.name()
    set fl_es[this.count]: 1
    set this.count: this.count + 1
    return: 0

  # Apply a functor: build a module from this app context (its config/services)
  # and register it. Analogous to an OCaml functor `module Make (Deps) = ...`.
  fn apply(f):
    set fl_m: f.make(this)
    call: this.use(fl_m)
    return: fl_m

  # ---- service container ----
  fn provide(name, val):
    call: this.registry.put(name, val)
    return: 0

  fn service(name):
    return: this.registry.get(name)

  fn has_service(name):
    return: this.registry.has(name)

  # ---- config (per-module parameters, e.g. "sound.track") ----
  fn set_config(key, val):
    call: this.config.put(key, val)
    return: 0

  fn config_or(key, fallback):
    if: this.config.has(key) == 1
      return: this.config.get(key)
    return: fallback

  # ---- module management ----
  fn index_of(name):
    set fl_i int: 0
    set fl_found int: 99
    while: fl_i < this.count
      if: this.names[fl_i] == name
        set fl_found: fl_i
      set fl_i: fl_i + 1
    return: fl_found

  fn is_enabled(name):
    set fl_idx int: this.index_of(name)
    if: fl_idx == 99
      return: 0
    return: this.enabled[fl_idx]

  fn enable(name):
    set fl_idx int: this.index_of(name)
    if: fl_idx == 99
      return: 0
    set fl_es: this.enabled
    set fl_es[fl_idx]: 1
    return: 0

  fn disable(name):
    set fl_idx int: this.index_of(name)
    if: fl_idx == 99
      return: 0
    set fl_es: this.enabled
    set fl_es[fl_idx]: 0
    return: 0

  # Re-initialise one module (calls its reload hook).
  fn reload(name):
    set fl_idx int: this.index_of(name)
    if: fl_idx == 99
      return: 0
    set fl_m: this.mods[fl_idx]
    call: fl_m.reload(this)
    return: 0

  # ---- events: delivered to every enabled module ----
  fn emit(type, payload):
    set fl_i int: 0
    while: fl_i < this.count
      if: this.enabled[fl_i] == 1
        set fl_m: this.mods[fl_i]
        call: fl_m.on_event(type, payload)
      set fl_i: fl_i + 1
    return: 0

  # ---- lifecycle ----
  fn verify():
    set fl_i int: 0
    set fl_ok int: 1
    while: fl_i < this.count
      set fl_m: this.mods[fl_i]
      set fl_reqs: fl_m.requires()
      set fl_rn int: len(fl_reqs)
      set fl_r int: 0
      while: fl_r < fl_rn
        set fl_need: fl_reqs[fl_r]
        if: this.registry.has(fl_need) == 0
          print: "flOW: module '" + fl_m.name() + "' needs missing service '" + fl_need + "'"
          set fl_ok: 0
        set fl_r: fl_r + 1
      set fl_i: fl_i + 1
    return: fl_ok

  fn boot():
    set fl_i int: 0
    while: fl_i < this.count
      set fl_m: this.mods[fl_i]
      call: fl_m.register(this)
      set fl_i: fl_i + 1
    set fl_ok int: this.verify()
    if: fl_ok == 0
      print: "flOW: boot aborted (unsatisfied dependencies)."
      return: 0
    set fl_j int: 0
    while: fl_j < this.count
      set fl_m2: this.mods[fl_j]
      call: fl_m2.start(this)
      set fl_j: fl_j + 1
    print: "flOW: booted " + this.count + " module(s)."
    return: 1
