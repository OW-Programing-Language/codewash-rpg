# Maps a mob name to its sprite file, ported from the JS asset maps
# (HOSTILE_MOBS / MINIBOSS_MOBS / BOSS_MOBS in src/constants/gameData.jsx).
# Paths are relative to the `ow/` working directory so the GUI finds the
# original art in ../public/assets. Unknown names fall back to the Zombie sprite.
# Requires OW's native dictionaries and map_get (ow-lang PR #43).
class MobArt:
  field base
  field sprites
  field chests

  fn new():
    set this.base: "../public/assets/mobs/"
    set this.sprites: {
      "Blaze": "hostile/blaze.gif",
      "Bogged": "hostile/bogged.png",
      "Breeze": "hostile/breeze.webp",
      "Creeper": "hostile/creeper.png",
      "Drowned": "hostile/drowned.png",
      "Enderman": "hostile/enderman.png",
      "Evoker": "hostile/evoker.png",
      "Ghast": "hostile/ghast.gif",
      "Guardian": "hostile/guardian.gif",
      "Hoglin": "hostile/hoglin.png",
      "Magma Cube": "hostile/magmacube.png",
      "Parched": "hostile/parched.png",
      "Phantom": "hostile/phantom.gif",
      "Piglin": "hostile/piglin.png",
      "Pillager": "hostile/pillager.png",
      "Skeleton": "hostile/skeleton.png",
      "Slime": "hostile/slime.png",
      "Spider": "hostile/spider.png",
      "Witch": "hostile/witch.png",
      "Zombie": "hostile/zombie.png",
      "Creaking": "miniboss/creaking.png",
      "Elder Guardian": "miniboss/elderguardian.gif",
      "Ravager": "miniboss/ravager.png",
      "Wither Skeleton": "miniboss/witherskeleton.png",
      "Ender Dragon": "boss/enderdragon.gif",
      "Herobrine": "boss/Herobrine.png",
      "Warden": "boss/warden.gif",
      "Wither": "boss/wither.png"
    }
    # Chest/block sprites for the Cleaning skill (ported from CHEST_BLOCKS).
    set this.chests: {
      "Chest": "chests/chest.gif",
      "Trapped Chest": "chests/trapped_chest.gif",
      "Barrel": "chests/barrel.png",
      "Bundle": "bundle.png",
      "Shulker Box": "chests/shulker_box.png",
      "Ender Chest": "chests/ender_chest.gif"
    }

  fn path(name):
    return: this.base + map_get(this.sprites, name, "hostile/zombie.png")

  fn chest_path(name):
    return: "../public/assets/items/" + map_get(this.chests, name, "chests/chest.gif")
